<script id="member-form-final-js">
document.addEventListener("DOMContentLoaded", function () {

  const modal = document.getElementById("memberModal");
  if (!modal) return;

  const name = document.getElementById("memberName");
  const phone = document.getElementById("memberPhone");

  /* اسم العنصر */
  if (name) {
    name.placeholder = "";
    name.removeAttribute("placeholder");
    name.setAttribute("lang", "ar");
    name.setAttribute("dir", "rtl");

    name.addEventListener("input", function () {
      this.value = this.value.replace(/[^\u0600-\u06FF\s]/g, "");
    });
  }

  /* رقم الهاتف */
  if (phone) {
    phone.placeholder = "";
    phone.removeAttribute("placeholder");
    phone.setAttribute("inputmode", "numeric");
    phone.setAttribute("autocomplete", "off");
    phone.setAttribute("dir", "ltr");

    phone.addEventListener("input", function () {
      this.value = this.value.replace(/\D/g, "");
    });
  }

  /* تاريخ الميلاد */
  if (birth) {
    birth.placeholder = "اليوم / الشهر / السنة";
    birth.setAttribute("inputmode", "numeric");
    birth.setAttribute("autocomplete", "bday");
    birth.setAttribute("dir", "ltr");

    birth.addEventListener("input", function () {
      let value = this.value.replace(/\D/g, "").slice(0, 8);

      if (value.length > 4) {
        value =
          value.slice(0, 2) + "/" +
          value.slice(2, 4) + "/" +
          value.slice(4);
      } else if (value.length > 2) {
        value =
          value.slice(0, 2) + "/" +
          value.slice(2);
      }

      this.value = value;
    });
  }

  /* Labels */
  modal.querySelectorAll(".form-group, .form-field, .input-group").forEach(group => {

    const input = group.querySelector(
      "input:not([type='radio']):not([type='checkbox']), textarea, select"
    );

    if (!input) return;

    let label = group.querySelector("label");

    if (!label) {
      label = document.createElement("label");
      label.htmlFor = input.id;
      group.insertBefore(label, input);
    }

    if (input.id === "memberName") {
      label.textContent = "اسم العنصر";
    }

    if (input.id === "memberPhone") {
      label.textContent = "رقم الهاتف";
    }
  });

});
