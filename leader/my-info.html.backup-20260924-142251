<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>معلوماتي - كشافة الرسالة</title>
  <link rel="stylesheet" href="../styles/leader-my-info.css">
</head>
<body>

  <header class="topbar">
    <button class="back-button" type="button" onclick="goBack()" aria-label="رجوع">‹</button>
    <span class="topbar-title">معلوماتي</span>
  </header>

  <main class="my-info-page">

    <section class="fixed-profile">

      <label class="large-profile-image" id="largeProfileImage" for="leaderProfileImageInput" title="اختيار صورة شخصية"><span>👤</span></label><div class="leader-profile-image-actions"><button type="button" id="deleteLeaderProfileImage" class="delete-profile-image-button" style="display:none;">حذف الصورة</button><input type="file" id="leaderProfileImageInput" accept="image/*" style="display:none;"></div>

      <h1 id="leaderName">القائد</h1>

    </section>

    <section class="info-scroll">

      <div class="info-list">

        <div class="info-row">
          <span class="info-label">رقم الهاتف</span>
          <strong id="leaderPhone" dir="ltr" style="direction:ltr; unicode-bidi:isolate; display:inline-block; white-space:pre;">غير محدد</strong>
        </div>

        <div class="info-row">
          <span class="info-label">تاريخ الميلاد</span>
          <strong id="leaderBirthDate">غير محدد</strong>
        </div>

        <div class="info-row">
          <span class="info-label">المهمة</span>
          <strong id="leaderTask">غير محددة</strong>
        </div>

        <div class="info-row">
          <span class="info-label">الفرقة</span>
          <strong id="leaderTeam">غير محددة</strong>
        </div>

        <div class="info-row">
          <span class="info-label">المساعدون</span>
          <strong id="leaderAssistants">لا يوجد</strong>
        </div>

      </div>

    </section>

    <section class="fixed-actions">
      <button class="edit-button" type="button" id="editInfoButton">
        تعديل المعلومات
      </button>
    </section>

    <div class="edit-modal" id="editModal">
      <div class="edit-modal-overlay" onclick="closeEditModal()"></div>

      <div class="edit-modal-box">
        <div class="edit-modal-header">
          <h2>تعديل المعلومات</h2>
          <button type="button" class="close-edit-button" onclick="closeEditModal()">×</button>
        </div>

        <div class="edit-form">

          <label class="edit-field">
            <span>الاسم</span>
            <input id="editName" type="text" autocomplete="name" lang="ar" dir="rtl">
          </label>

          <label class="edit-field">
            <span>رقم الهاتف</span>
            <div class="phone-field">
              <span class="phone-prefix">+961</span>
              <input id="editPhone" type="tel" inputmode="numeric" autocomplete="tel" dir="ltr" style="direction:ltr; text-align:left;">
            </div>
          </label>

          <div class="edit-field">
            <span>تاريخ الميلاد</span>
            <div class="birth-selects">
              <select id="editBirthDay"></select>
              <select id="editBirthMonth"></select>
              <select id="editBirthYear"></select>
            </div>
          </div>

          <label class="edit-field">
            <span>المساعدون</span>
            <input id="editAssistants" type="text" lang="ar" dir="rtl">
          </label>

          <p class="edit-error" id="editError"></p>

          <button type="button" class="save-edit-button" id="saveEditButton" onclick="saveMyInfo()">
            حفظ التعديلات
          </button>

        </div>
      </div>
    </div>

  </main>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="../supabase.js"></script></script>

  <script>
const leaderId = new URLSearchParams(window.location.search).get("id");
let currentLeader = null;

function escapeHtml(value) {
  return String(value ?? "")
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}

function goBack() {
  if (leaderId) {
    window.location.href =
      "../leader-dashboard.html?id=" + encodeURIComponent(leaderId);
  } else {
    window.history.back();
  }
}

function fillBirthSelectors() {
  const day = document.getElementById("editBirthDay");
  const month = document.getElementById("editBirthMonth");
  const year = document.getElementById("editBirthYear");

  if (!day || !month || !year) return;

  day.innerHTML = '<option value="">اليوم</option>';
  month.innerHTML = '<option value="">الشهر</option>';
  year.innerHTML = '<option value="">السنة</option>';

  for (let i = 1; i <= 31; i++) {
    day.insertAdjacentHTML(
      "beforeend",
      '<option value="' + String(i).padStart(2, "0") + '">' + i + "</option>"
    );
  }

  for (let i = 1; i <= 12; i++) {
    month.insertAdjacentHTML(
      "beforeend",
      '<option value="' + String(i).padStart(2, "0") + '">' + i + "</option>"
    );
  }

  const currentYear = new Date().getFullYear();

  for (let i = currentYear; i >= 1940; i--) {
    year.insertAdjacentHTML(
      "beforeend",
      '<option value="' + i + '">' + i + "</option>"
    );
  }
}

function setBirthDateSelectors(value) {
  const day = document.getElementById("editBirthDay");
  const month = document.getElementById("editBirthMonth");
  const year = document.getElementById("editBirthYear");

  if (!day || !month || !year) return;

  day.value = "";
  month.value = "";
  year.value = "";

  if (!value) return;

  const parts = String(value).split("-");

  if (parts.length !== 3) return;

  year.value = parts[0];
  month.value = parts[1];
  day.value = parts[2];
}

function getBirthDateValue() {
  const day = document.getElementById("editBirthDay")?.value || "";
  const month = document.getElementById("editBirthMonth")?.value || "";
  const year = document.getElementById("editBirthYear")?.value || "";

  if (!day && !month && !year) return null;

  if (!day || !month || !year) return null;

  return year + "-" + month + "-" + day;
}

function normalizePhone(value) {
  let digits = String(value || "").replace(/\D/g, "");

  if (digits.startsWith("961")) {
    digits = digits.slice(3);
  }

  if (digits.startsWith("0")) {
    digits = digits.slice(1);
  }

  return digits;
}

async function loadLeaderTeam(teamId) {
  const teamElement = document.getElementById("leaderTeam");

  if (!teamElement) return;

  // The team name follows the leader's task automatically.
  const taskElement = document.getElementById("leaderTask");

  if (!taskElement) {
    teamElement.textContent = "غير محددة";
    return;
  }

  const taskName = taskElement.textContent.trim();

  teamElement.textContent =
    taskName && taskName !== "غير محددة"
      ? taskName
      : "غير محددة";
}

async function loadLeaderProfileImage(profileId) {
  const imageBox = document.getElementById("largeProfileImage");

  if (!imageBox) return;

  imageBox.innerHTML = "<span>👤</span>";

  if (!profileId) return;

  const { data: profile, error } = await supabaseClient
    .from("profiles")
    .select("profile_image")
    .eq("id", profileId)
    .single();

  if (!error && profile && profile.profile_image) {
    imageBox.innerHTML =
      '<img src="' +
      escapeHtml(profile.profile_image) +
      '" alt="صورة القائد">';
  }
}

async function loadMyInfo() {
  if (!leaderId) {
    console.error("Leader ID is missing from My Info URL.");
    goBack();
    return;
  }

  const { data, error } = await AppDb.getLeaderById(leaderId);

  if (error || !data || data.deleted_at) {
    console.error("Leader info load error:", error);
    goBack();
    return;
  }

  currentLeader = data;

  document.getElementById("leaderName").textContent =
    data.full_name || "القائد";

  const displayedPhone = data.phone
    ? String(data.phone).replace(/^\+961\s*/, "+961 ")
    : "غير محدد";

  document.getElementById("leaderPhone").textContent = displayedPhone;

  document.getElementById("leaderBirthDate").textContent =
    data.birth_date || "غير محدد";

  document.getElementById("leaderTask").textContent =
    data.branch || "غير محددة";

  document.getElementById("leaderAssistants").textContent =
    data.assistants || "لا يوجد";

  await loadLeaderTeam(data.team_id);
  await loadLeaderProfileImage(leaderId);
}

async function editMyInfo() {
  if (!currentLeader) {
    await loadMyInfo();
  }

  if (!currentLeader) return;

  const modal = document.getElementById("editModal");
  const errorBox = document.getElementById("editError");

  if (!modal) return;

  fillBirthSelectors();

  document.getElementById("editName").value =
    currentLeader.full_name || "";

  document.getElementById("editPhone").value =
    normalizePhone(currentLeader.phone || "");

  document.getElementById("editAssistants").value =
    currentLeader.assistants || "";

  setBirthDateSelectors(currentLeader.birth_date);

  if (errorBox) {
    errorBox.textContent = "";
  }

  modal.classList.add("open");
  document.body.classList.add("modal-open");
}

function closeEditModal() {
  const modal = document.getElementById("editModal");

  if (modal) {
    modal.classList.remove("open");
  }

  document.body.classList.remove("modal-open");
}

async function saveMyInfo() {
  if (!currentLeader) {
    await loadMyInfo();
  }

  if (!currentLeader) return;

  const button = document.getElementById("saveEditButton");
  const errorBox = document.getElementById("editError");

  const name =
    document.getElementById("editName").value.trim();

  const phone =
    normalizePhone(document.getElementById("editPhone").value);

  const birthDate =
    getBirthDateValue();

  const assistants =
    document.getElementById("editAssistants").value.trim();

  if (errorBox) {
    errorBox.textContent = "";
  }

  if (!name) {
    if (errorBox) {
      errorBox.textContent = "يرجى إدخال الاسم.";
    }
    return;
  }

  // Arabic letters, spaces, and common Arabic name marks only.
  if (!/^[\u0600-\u06FF\u0750-\u077F\u08A0-\u08FF\s]+$/.test(name)) {
    if (errorBox) {
      errorBox.textContent = "الاسم يجب أن يكون باللغة العربية فقط.";
    }
    return;
  }

  // Assistants are optional, but if entered they must be Arabic only.
  if (assistants && !/^[\u0600-\u06FF\u0750-\u077F\u08A0-\u08FF\s\/]+$/.test(assistants)) {
    if (errorBox) {
      errorBox.textContent = "أسماء المساعدين يجب أن تكون باللغة العربية فقط.";
    }
    return;
  }

  if (phone && !/^\d{7,8}$/.test(phone)) {
    if (errorBox) {
      errorBox.textContent =
        "يرجى إدخال رقم الهاتف بشكل صحيح بعد +961.";
    }
    return;
  }

  const hasSomeBirthValue =
    document.getElementById("editBirthDay").value ||
    document.getElementById("editBirthMonth").value ||
    document.getElementById("editBirthYear").value;

  if (hasSomeBirthValue && !birthDate) {
    if (errorBox) {
      errorBox.textContent =
        "يرجى اختيار تاريخ الميلاد كاملًا.";
    }
    return;
  }

  const changes = {
    full_name: name,
    phone: phone ? "+961" + phone : null,
    birth_date: birthDate,
    assistants: assistants || null
  };

  if (button) {
    button.disabled = true;
    button.textContent = "جارٍ الحفظ...";
  }

  const result = await AppDb.updateLeader(
    currentLeader.id,
    changes
  );

  if (button) {
    button.disabled = false;
    button.textContent = "حفظ التعديلات";
  }

  if (result.error) {
    console.error("Leader update error:", result.error);

    if (errorBox) {
      errorBox.textContent =
        "تعذر حفظ التعديلات. حاول مرة أخرى.";
    }

    return;
  }

  closeEditModal();
  await loadMyInfo();
}

/* Leader profile image controls */ const leaderProfileImageInput=document.getElementById("leaderProfileImageInput"); const deleteLeaderProfileImage=document.getElementById("deleteLeaderProfileImage"); if(leaderProfileImageInput){leaderProfileImageInput.addEventListener("change",async function(){const file=this.files[0];if(!file)return;if(!file.type.startsWith("image/")){alert("الرجاء اختيار صورة فقط.");this.value="";return}if(!currentLeader||!leaderId){alert("لم نتمكن من تحديد حساب القائد.");this.value="";return}try{const profileId=leaderId;const {error:uploadError}=await AppDb.uploadProfileImage(profileId,file);if(uploadError)throw uploadError;const {data:urlData}=AppDb.getProfileImagePublicUrl(profileId,file);const imageUrl=urlData.publicUrl;const {error:updateError}=await AppDb.updateLeader(leaderId,{profile_image:imageUrl});if(updateError)throw updateError;await loadLeaderProfileImage(profileId);this.value=""}catch(error){console.error("Error saving leader profile image:",error);alert("لم نتمكن من حفظ الصورة.")}})} if(deleteLeaderProfileImage){deleteLeaderProfileImage.addEventListener("click",async function(){if(!currentLeader||!leaderId)return;if(!confirm("هل تريدين حذف الصورة الشخصية؟"))return;try{const profileId=leaderId;const {data:files,error:listError}=await AppDb.listProfileFiles(profileId);if(listError)throw listError;if(files&&files.length>0){const filePaths=files.map(file=>profileId+"/"+file.name);const {error:removeError}=await AppDb.removeProfileFiles(filePaths);if(removeError)throw removeError}const {error:updateError}=await AppDb.updateProfile(profileId,{profile_image:null});if(updateError)throw updateError;await loadLeaderProfileImage(profileId);if(leaderProfileImageInput)leaderProfileImageInput.value=""}catch(error){console.error("Error deleting leader profile image:",error);alert("لم نتمكن من حذف الصورة.")}})} const editInfoButton =
  document.getElementById("editInfoButton");

if (editInfoButton) {
  editInfoButton.addEventListener("click", editMyInfo);
}

loadMyInfo();
</script>
<script id="arabic-input-only-fix">
(function () {
  function keepArabicOnly(input, allowSlash) {
    if (!input) return;

    input.addEventListener("keydown", function (event) {
      // Allow control/navigation keys.
      if (
        event.ctrlKey ||
        event.altKey ||
        event.metaKey ||
        [
          "Backspace",
          "Delete",
          "ArrowLeft",
          "ArrowRight",
          "ArrowUp",
          "ArrowDown",
          "Home",
          "End",
          "Tab",
          "Enter"
        ].includes(event.key)
      ) {
        return;
      }

      // Block English letters immediately.
      if (/^[A-Za-z]$/.test(event.key)) {
        event.preventDefault();
        return;
      }

      // For assistants, allow slash.
      if (allowSlash && event.key === "/") {
        return;
      }

      // Block other Latin characters.
      if (/[A-Za-z]/.test(event.key)) {
        event.preventDefault();
      }
    });

    input.addEventListener("input", function () {
      const pattern = allowSlash
        ? /[A-Za-z]/g
        : /[A-Za-z]/g;

      input.value = input.value.replace(pattern, "");
    });
  }

  keepArabicOnly(
    document.getElementById("editName"),
    false
  );

  keepArabicOnly(
    document.getElementById("editAssistants"),
    true
  );
})();
</script>
<script id="phone-spacing-fix">
(function () {
  const phoneInput = document.getElementById("editPhone");

  if (!phoneInput) return;

  phoneInput.setAttribute("dir", "ltr");
  phoneInput.style.direction = "ltr";
  phoneInput.style.textAlign = "left";

  phoneInput.addEventListener("keydown", function (event) {
    // Allow normal navigation/editing keys.
    if (
      event.ctrlKey ||
      event.altKey ||
      event.metaKey ||
      [
        "Backspace",
        "Delete",
        "ArrowLeft",
        "ArrowRight",
        "ArrowUp",
        "ArrowDown",
        "Home",
        "End",
        "Tab"
      ].includes(event.key)
    ) {
      return;
    }

    // Allow digits and spaces only.
    if (!/^[0-9 ]$/.test(event.key)) {
      event.preventDefault();
    }
  });
})();
</script>

</body>
</html>


















