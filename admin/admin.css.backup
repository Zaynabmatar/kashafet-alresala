* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html,
body {
  width: 100%;
  min-height: 100%;
  margin: 0;
  padding: 0;
  overflow-x: hidden;
}

body {
  font-family: Arial, Tahoma, sans-serif;
  background: #f4f7f5;
  color: #1f2d25;
  min-height: 100vh;
}

/* =========================
   TOP BAR
========================= */

.topbar {
  width: 100%;
  height: 76px;
  padding: 0 32px;
  background: #145c45;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
  position: relative;
  z-index: 10;
}

.user-area {
  display: flex;
  align-items: center;
  gap: 14px;
  min-width: 0;
  flex: 1;
}

.menu-button {
  border: none;
  background: transparent;
  color: white;
  font-size: 28px;
  cursor: pointer;
  padding: 4px 8px;
  flex-shrink: 0;
}

.profile-image {
  width: 44px;
  height: 44px;
  min-width: 44px;
  border-radius: 50%;
  background: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23px;
  flex-shrink: 0;
}

.user-name {
  color: white;
  font-size: 17px;
  font-weight: 600;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.logout-button {
  border: 1px solid rgba(255, 255, 255, 0.7);
  background: transparent;
  color: white;
  padding: 9px 18px;
  border-radius: 8px;
  cursor: pointer;
  font-size: 14px;
  white-space: nowrap;
  flex-shrink: 0;
}

.logout-button:hover {
  background: rgba(255, 255, 255, 0.12);
}

/* =========================
   MAIN
========================= */

.container {
  width: min(1180px, calc(100% - 48px));
  max-width: 1180px;
  margin: 38px auto;
}

.page-header {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 30px;
}

.page-header h1 {
  font-size: 30px;
  margin-bottom: 7px;
}

.page-header p {
  color: #718078;
  font-size: 15px;
}

/* =========================
   ADD LEADER
========================= */

.add-leader {
  border: none;
  background: #225d3c;
  color: white;
  padding: 13px 22px;
  border-radius: 10px;
  font-size: 16px;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 9px;
  flex-shrink: 0;
}

.add-leader span {
  font-size: 23px;
  line-height: 1;
}

.add-leader:hover {
  background: #1b4f32;
}

/* =========================
   LEADERS
========================= */

.leaders-table-wrapper {
  width: 100%;
  min-width: 0;
}

.leaders-table {
  width: 100%;
  min-width: 0;
  display: none;
  flex-direction: column;
  gap: 14px;
}

.leader-row {
  width: 100%;
  min-width: 0;
  background: white;
  border: 1px solid #e1e8e3;
  border-radius: 16px;
  padding: 18px 20px;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
  cursor: pointer;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  overflow: hidden;
}

.leader-row:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 28px rgba(0, 0, 0, 0.1);
}

.leader-row:focus {
  outline: 2px solid #225d3c;
  outline-offset: 3px;
}

/* =========================
   LEADER MAIN
========================= */

.leader-main {
  width: 100%;
  min-width: 0;
  min-height: 108px;

  display: grid;

  grid-template-columns:
    minmax(0, 1.15fr)
    minmax(0, 1.35fr)
    minmax(105px, 135px)
    30px;

  align-items: center;
  gap: 16px;

  direction: rtl;
}

/* =========================
   PROFILE
========================= */

.leader-profile {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 14px;
  direction: rtl;
}

.leader-avatar {
  width: 62px;
  height: 62px;
  min-width: 62px;
  border-radius: 50%;
  background: #edf2ef;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  flex-shrink: 0;
}

.leader-identity {
  min-width: 0;
  text-align: right;
}

.leader-identity h3 {
  font-size: 18px;
  margin-bottom: 7px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.leader-identity p {
  margin: 0;
  color: #5f6d65;
  font-size: 14px;
  direction: ltr;
  text-align: right;
}

.phone-icon {
  color: #225d3c;
  font-size: 17px;
  margin-left: 5px;
}

/* =========================
   INFORMATION
========================= */

.leader-info {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  direction: rtl;
}

.compact-info {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 7px;
  white-space: nowrap;
  color: #34483d;
}

.compact-info strong {
  font-size: 13px;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
}

.compact-icon {
  color: #225d3c;
  font-size: 18px;
  line-height: 1;
  flex-shrink: 0;
}

/* =========================
   UNIFORM
========================= */

.uniform-status {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  white-space: nowrap;
}

.uniform-check {
  width: 21px;
  height: 21px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: white;
  font-size: 12px;
  font-weight: 700;
  flex-shrink: 0;
}

.uniform-check.has-uniform {
    background: #e4f6e9;
    color: #218739;
}

.uniform-check.no-uniform {
    background: #ffe6e6;
    color: #d62828;
}

.uniform-text {
  font-size: 13px;
  font-weight: 600;
}

.uniform-text.has-uniform {
    background: #e4f6e9;
    color: #218739;
}

.uniform-text.no-uniform {
    background: #ffe6e6;
    color: #d62828;
}

/* =========================
   ACTIVITIES
========================= */

.activities-box {
  width: 135px;
  min-width: 0;
  padding: 11px 14px;
  border-radius: 10px;
  background: #f1f7f4;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  direction: rtl;
}

.activities-box span {
  display: block;
  font-size: 12px;
  color: #607168;
  margin-bottom: 4px;
}

.activities-box strong {
  display: block;
  font-size: 20px;
  color: #225d3c;
}

/* =========================
   ARROW
========================= */

.leader-arrow {
  color: #225d3c;
  font-size: 31px;
  font-weight: 400;
  text-align: center;
  direction: ltr;
  line-height: 1;
}

/* =========================
   EMPTY
========================= */

.empty-state {
  width: 100%;
  background: white;
  border: 1px dashed #cbd7d0;
  border-radius: 16px;
  min-height: 220px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 30px;
}

.empty-icon {
  font-size: 42px;
  margin-bottom: 12px;
}

.empty-state h2 {
  font-size: 20px;
  margin-bottom: 7px;
}

.empty-state p {
  color: #78847d;
  font-size: 14px;
}

/* =========================
   MODAL
========================= */

.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  display: none;
  align-items: center;
  justify-content: center;
  padding: 20px;
  z-index: 1000;
}

.modal-overlay.active {
  display: flex;
}

.modal {
  width: min(620px, 100%);
  max-height: 90vh;
  overflow-y: auto;
  background: white;
  border-radius: 18px;
  padding: 28px;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
}

.modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 25px;
}

.modal-header h2 {
  font-size: 25px;
  margin-bottom: 6px;
}

.modal-header p {
  color: #7a8580;
  font-size: 14px;
}

.close-button {
  border: none;
  background: transparent;
  font-size: 30px;
  color: #69736e;
  cursor: pointer;
}

/* =========================
   FORM
========================= */

.form-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 18px;
}

.form-group > label {
  font-size: 14px;
  font-weight: 600;
}

.form-group input {
  width: 100%;
  border: 1px solid #d7dfda;
  border-radius: 9px;
  padding: 12px;
  font-size: 15px;
  outline: none;
}

.form-group input:focus,
.form-group select:focus {
  border-color: #176b3a;
}

#leaderName,
#leaderBranch {
  direction: rtl;
  text-align: right;
}

#leaderName::placeholder,
#leaderBranch::placeholder {
  text-align: right;
}

/* =========================
   PHONE
========================= */

.phone-input {
  display: flex;
  direction: ltr;
}

.country-code {
  min-width: 70px;
  background: #edf2ef;
  border: 1px solid #d7dfda;
  border-left: none;
  border-radius: 9px 0 0 9px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #344039;
  font-weight: 600;
  font-size: 14px;
}

.phone-input input {
  border-radius: 0 9px 9px 0;
}

/* =========================
   BIRTH DATE
========================= */

.birth-date {
  display: grid;
  grid-template-columns: 1fr 1.5fr 1.2fr;
  gap: 10px;
}

.birth-date select {
  width: 100%;
  border: 1px solid #d7dfda;
  border-radius: 9px;
  padding: 12px;
  font-size: 14px;
  background: white;
  outline: none;
  cursor: pointer;
}

/* =========================
   UNIFORM FORM
========================= */

.uniform-options {
  display: flex;
  gap: 25px;
}

.radio-option {
  display: flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  font-weight: normal;
}

.radio-option input {
  width: auto;
}

.uniform-options .radio-option:first-child {
  color: #225d3c;
}

.uniform-options .radio-option:last-child {
  color: #e05252;
}

/* =========================
   BUTTONS
========================= */

.form-actions {
  display: flex;
  justify-content: flex-start;
  gap: 12px;
  margin-top: 28px;
}

.save-button,
.cancel-button {
  border: none;
  padding: 11px 25px;
  border-radius: 9px;
  font-size: 15px;
  cursor: pointer;
}

.save-button {
  background: #225d3c;
  color: white;
}

.save-button:hover {
  background: #12552e;
}

.save-button:disabled {
  opacity: 0.7;
  cursor: wait;
}

.cancel-button {
  background: #e9eeeb;
  color: #344039;
}

.cancel-button:hover {
  background: #dce4df;
}

/* =========================
   RESPONSIVE
========================= */

@media (max-width: 1050px) {
  .topbar {
    padding-left: 20px;
    padding-right: 20px;
  }

  .container {
    width: calc(100% - 32px);
  }

  .leader-main {
    grid-template-columns:
      minmax(0, 1fr)
      minmax(0, 1.2fr)
      120px
      25px;
    gap: 12px;
  }

  .leader-info {
    gap: 10px;
  }

  .compact-info strong {
    font-size: 12px;
  }

  .uniform-text {
    font-size: 12px;
  }
}

@media (max-width: 850px) {
  .leader-main {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .leader-profile {
    grid-column: 1 / -1;
  }

  .leader-info {
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: 16px;
  }

  .activities-box {
    width: 100%;
  }
}

@media (max-width: 600px) {
  .topbar {
    height: 68px;
    padding-left: 12px;
    padding-right: 12px;
  }

  .user-area {
    gap: 8px;
  }

  .menu-button {
    font-size: 24px;
    padding: 4px;
  }

  .profile-image {
    width: 40px;
    height: 40px;
    min-width: 40px;
    font-size: 20px;
  }

  .user-name {
    font-size: 14px;
  }

  .logout-button {
    padding: 8px 11px;
    font-size: 12px;
  }

  .container {
    width: calc(100% - 24px);
    margin: 25px auto;
  }

  .page-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .add-leader {
    width: 100%;
    justify-content: center;
  }

  .leader-main {
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .leader-info {
    justify-content: flex-start;
  }

  .activities-box {
    width: 100%;
  }

  .leader-arrow {
    display: none;
  }

  .birth-date {
    grid-template-columns: 1fr;
  }

  .modal {
    padding: 22px;
  }
}


