    <script>
      /* =====================================================
   ADMIN NAME
===================================================== */

      async function loadAdminName() {
        try {
          const { data, error } = await AppDb.getAdminSummary();

          if (error) {
            console.error("Error loading admin:", error);

            return;
          }

          const profileImage = document.getElementById("adminProfileImage"); if (profileImage) { profileImage.innerHTML = data && data.profile_image ? "<img src=\"" + data.profile_image + "\" alt=\"صورة البروفايل\">" : "<span>👤</span>"; } if (data && data.full_name) {
            document.getElementById("userName").textContent = data.full_name;
          }
        } catch (error) {
          console.error("Admin loading error:", error);
        }
      }

      /* =====================================================
   DATE SELECTORS
===================================================== */
/* =====================================================
   MODAL
===================================================== */

      function openAddLeaderForm() {
        const modal = document.getElementById("leaderModal");

        if (modal) {
          modal.classList.add("active");
        }
      }

      function closeAddLeaderForm() {
        const modal = document.getElementById("leaderModal");

        if (modal) {
          modal.classList.remove("active");
        }
      }

      /* =====================================================
   AGE
===================================================== */

      function calculateAge(birthDate) {
        if (!birthDate) {
          return "غير محدد";
        }

        const birth = new Date(birthDate);

        if (isNaN(birth.getTime())) {
          return "غير محدد";
        }

        const today = new Date();

        let age = today.getFullYear() - birth.getFullYear();

        const monthDifference = today.getMonth() - birth.getMonth();

        if (
          monthDifference < 0 ||
          (monthDifference === 0 && today.getDate() < birth.getDate())
        ) {
          age--;
        }

        return age >= 0 ? `${age} سنة` : "غير محدد";
      }

      /* =====================================================
   LOAD LEADERS FROM SUPABASE
===================================================== */

      async function loadLeaders() {
        const table = document.getElementById("leadersTable");

        const emptyState = document.getElementById("emptyState");

        if (!table || !emptyState) {
          return false;
        }

        try {
          const { data, error } = await AppDb.listActiveLeaders();

          if (error) {
            throw error;
          }

          table.innerHTML = "";

          const leadersCount = document.getElementById("leadersCount");
    const missingUniformCount = document.getElementById("missingUniformCount");
    if (leadersCount) leadersCount.textContent = data ? data.length : 0;
    if (missingUniformCount) missingUniformCount.textContent = data ? data.filter(function(leader) { return leader.has_uniform === false; }).length : 0;

    if (!data || data.length === 0) {
            table.style.display = "none";

            emptyState.style.display = "block";

            return true;
          }

          emptyState.style.display = "none";

          table.style.display = "flex";

          data.forEach(function (leader) {
            addLeaderToTable({
              id: leader.id,

              name: leader.full_name,
              assistants: leader.assistants,

              phone: leader.phone,

              birthDate: leader.birth_date,

              branch: leader.branch,

              uniform: leader.has_uniform,

              activities: leader.activities || 0,
            });
          });

          return true;
        } catch (error) {
          console.error("Error loading leaders:", error);

          table.innerHTML = "";

          table.style.display = "none";

          emptyState.style.display = "block";

          /*
           * مهم:
           * loadLeaders ترجع false فقط.
           * ما رح ترمي error للحفظ.
           */

          return false;
        }
      }

      /* =====================================================
   SAVE NEW LEADER
===================================================== */

      const leaderForm = document.getElementById("leaderForm");

      if (leaderForm) {
        leaderForm.addEventListener("submit", async function (event) {
          event.preventDefault();

          const name = document.getElementById("leaderName").value.trim();
          const assistants = document.getElementById("leaderAssistants").value.trim();

          const phone = document.getElementById("leaderPhone").value.trim();
          const birthDate = document.getElementById("birthDateInput").value || null;

          const branch = document.getElementById("leaderBranch").value.trim();
          const selectedTaskId = document.getElementById("leaderBranch").dataset.selectedTaskId || null;

          const uniformInput = document.querySelector(
            'input[name="hasUniform"]:checked',
          );

          const uniform = uniformInput ? uniformInput.value === "true" : false;

          /* Validation */

          if (!name) {
            alert("يرجى إدخال اسم القائد.");

            return;
          }

          if (!branch) {
            alert("يرجى اختيار المهمة.");

            return;
          }
          // كل مهمة يمكن أن تكون لقائد Active واحد فقط.
          // إذا كان القائد القديم في سلة المحذوفات، تصبح المهمة متاحة من جديد.
          const { data: existingLeaders, error: duplicateCheckError } =
            await supabaseClient
              .from("leaders")
              .select("id, full_name, branch")
              .is("deleted_at", null)
              .eq("branch", branch)
              .limit(1);

          if (duplicateCheckError) {
            console.error(
              "Task availability check error:",
              duplicateCheckError,
            );

            alert("تعذّر التحقق من المهمة. لم يتم حفظ القائد.");
            return;
          }

          if (existingLeaders && existingLeaders.length > 0) {
            alert(
              "هذه المهمة مستخدمة حاليًا من قبل: " +
                (existingLeaders[0].full_name || "شخص آخر") +
                ".\nلا يمكن تعيين نفس المهمة لقائدين.",
            );

            return;
          }
/* Save button */

          const saveButton = document.getElementById("saveLeaderButton");

          if (saveButton) {
            saveButton.disabled = true;

            saveButton.textContent = "جارٍ الحفظ...";
          }

          try {
            /* =================================================
                   STEP 1 — ACTUAL DATABASE INSERT
                ================================================= */

            const { data, error } = await AppDb.createLeader({
              full_name: name,
              assistants: assistants || null,
              phone: phone || null,
              birth_date: birthDate,
              branch: branch,
              task_id: selectedTaskId,
              has_uniform: uniform,
            });

            /*
             * إذا Supabase أعطى error،
             * الحفظ فشل فعلًا.
             */

            if (error) {
              throw error;
            }

            /*
             * إذا وصلنا لهون:
             * القائد انحفظ فعليًا في Database.
             */

            console.log("Leader saved successfully:", data);
            /* =================================================
                   STEP 1.5 — AUTO LINK TEAM FOR "فرقة" TASKS
                ================================================= */

            if (selectedTaskId) {
              const { data: selectedTask, error: taskError } =
                await supabaseClient
                  .from("tasks")
                  .select("id, name")
