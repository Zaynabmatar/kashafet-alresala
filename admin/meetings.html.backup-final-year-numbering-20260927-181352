<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>الاجتماعات - كشافة الرسالة</title>

  <link rel="stylesheet" href="../styles/admin.css" />
  <link rel="stylesheet" href="../styles/meetings.css" />
</head>

<body>

  <header class="topbar">
    <div class="user-area">

        <button
            class="menu-button"
            type="button"
            onclick="window.location.href='admin.html'"
            title="العودة إلى قائمة القادة"
            aria-label="العودة إلى قائمة القادة"
        >
            ‹
        </button>

        <div class="page-topbar-title">الاجتماعات</div>

    </div>
</header>


  <main class="meetings-page">

    <section class="page-header meetings-header">
      <div>
        <h1>الاجتماعات</h1>
      </div>

      <button
        class="add-meeting-button"
        type="button"
        onclick="openMeetingModal()"
      >
        <span>＋</span>
        إضافة اجتماع
      </button>
    </section>


    <section class="meetings-list-section">

  <div class="meetings-list-section-header">

    <h2 class="meetings-list-title">
      سجل الاجتماعات
    </h2>

    <div class="meetings-year-control">
      <select
        id="yearFilter"
        class="year-filter"
        onchange="renderMeetings()"
      ></select>
    </div>

  </div>

  <div id="meetingsList" class="meetings-list">
        <div class="empty-state">
          لا يوجد اجتماعات بعد
        </div>
      </div>

    </section>

  </main>


  <!-- =========================
       إضافة اجتماع
  ========================== -->

  <div id="meetingModal" class="meeting-modal">

    <div class="meeting-modal-box">

      <div class="meeting-modal-header">

        <h2>إضافة اجتماع</h2>

        <button
          class="close-modal-button"
          type="button"
          onclick="closeMeetingModal()"
          aria-label="إغلاق"
        >
          ×
        </button>

      </div>


      <!-- التاريخ -->

      <div class="meeting-date-section">

        <label for="meetingDateTrigger">
          تاريخ الاجتماع
        </label>

        <div class="custom-date-picker" id="meetingDatePicker">

          <div class="typed-date-wrapper">

            <input
              type="text"
              id="meetingDateText"
              class="typed-date-input"
              inputmode="numeric"
              autocomplete="off"
              placeholder="٢٢/٠٩/٢٠٢٦"
              maxlength="10"
              oninput="handleTypedMeetingDate()"
            />

            <button
              id="meetingDateTrigger"
              class="calendar-icon-button"
              type="button"
              onclick="toggleMeetingDatePicker()"
              aria-expanded="false"
              aria-label="فتح الرزنامة"
            >
              📅
            </button>

          </div>

          <input type="hidden" id="meetingDate" />

          <div
            id="meetingDatePopover"
            class="custom-date-popover"
            aria-hidden="true"
          >
            <div class="date-picker-selects">

              <select
                id="meetingDay"
                aria-label="اليوم"
                onchange="syncMeetingDateFromPicker()"
              ></select>

              <select
                id="meetingMonth"
                aria-label="الشهر"
                onchange="syncMeetingDateFromPicker()"
              ></select>

              <select
                id="meetingYear"
                aria-label="السنة"
                onchange="syncMeetingDateFromPicker()"
              ></select>

            </div>
          </div>

        </div>

      </div>


      <!-- القادة -->

      <div class="attendees-section">

        <div class="leader-search">

          <span>⌕</span>

          <input
            type="text"
            id="leaderSearch"
            placeholder="بحث عن قائد..."
            autocomplete="off"
            spellcheck="false"
            oninput="handleLeaderSearchInput(this)"
            onkeydown="blockEnglishSearch(event)"
          />

        </div>


        <div
          id="leadersList"
          class="leaders-list"
        ></div>

      </div>


      <!-- الحفظ -->

      <button
        id="saveMeetingButton"
        class="save-meeting-button"
        type="button"
        onclick="saveMeeting()"
      >
        حفظ الاجتماع
      </button>

    </div>

  </div>


  <!-- Supabase -->

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2">
/* FULL_MEETINGS_RENUMBER_ON_LOAD */
async function renumberAllExistingMeetings() {
  try {
    const { data, error } = await supabaseClient
      .from("meetings")
      .select("id, title, meeting_date")
      .order("meeting_date", { ascending: true })
      .order("id", { ascending: true });

    if (error) {
      console.error("تعذر قراءة الاجتماعات لإعادة الترقيم:", error);
      return;
    }

    const meetingsByYear = new Map();

    for (const meeting of data || []) {
      const year = Number(
        String(meeting.meeting_date || "").slice(0, 4)
      );

      if (!Number.isInteger(year)) {
        continue;
      }

      if (!meetingsByYear.has(year)) {
        meetingsByYear.set(year, []);
      }

      meetingsByYear.get(year).push(meeting);
    }

    for (const [year, yearMeetings] of meetingsByYear) {
      yearMeetings.sort((a, b) => {
        const dateCompare =
          String(a.meeting_date || "").localeCompare(
            String(b.meeting_date || "")
          );

        if (dateCompare !== 0) {
          return dateCompare;
        }

        return String(a.id).localeCompare(String(b.id));
      });

      for (let index = 0; index < yearMeetings.length; index++) {
        const meeting = yearMeetings[index];
        const newTitle =
          `الاجتماع رقم ${toArabicDigits(index + 1)}`;

        if (meeting.title === newTitle) {
          continue;
        }

        const { error: updateError } = await supabaseClient
          .from("meetings")
          .update({ title: newTitle })
          .eq("id", meeting.id);

        if (updateError) {
          console.error(
            "تعذر تحديث ترقيم الاجتماع:",
            meeting.id,
            updateError
          );
        }
      }
    }

    console.log("تمت إعادة ترقيم جميع الاجتماعات حسب التاريخ.");
  } catch (error) {
    console.error("خطأ أثناء إعادة ترقيم الاجتماعات:", error);
  }
}

window.addEventListener("load", () => {
  setTimeout(() => {
    renumberAllExistingMeetings();
  }, 300);
});
</script>
