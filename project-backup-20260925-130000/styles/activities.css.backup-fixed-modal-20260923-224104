* {
    box-sizing: border-box;
}

html {
    direction: rtl;
}

body {
    margin: 0;
    font-family: Arial, "Tahoma", sans-serif;
    background: #f7f9f8;
    color: #222;
}

.activities-topbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: 76px;
    background: #145c45;
    z-index: 1000;
    box-sizing: border-box;
}

.activities-topbar-inner {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 8px;
    padding: 0 24px;
}

.activities-back-button {
    width: 30px;
    height: 36px;
    border: 0;
    background: transparent;
    color: #fff;
    font-size: 27px;
    line-height: 1;
    padding: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
}

.activities-back-button:hover {
    opacity: 0.8;
}

.activities-topbar-title {
    color: #fff;
    font-size: 20px;
    font-weight: 700;
}

.activities-page {
    padding: 30px;
    max-width: 1100px;
    margin: 0 auto;
    padding-top: 106px;
}

.activities-header {
    margin-bottom: 18px;
}

.activities-header h1 {
    margin: 0;
    font-size: 25px;
    color: #173b2a;
}

.add-activity-section {
    margin-bottom: 25px;
}

.add-activity-button {
    border: none;
    background: #176b3a;
    color: #fff;
    padding: 13px 22px;
    border-radius: 10px;
    font-size: 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 52px;
}

.add-activity-button:hover {
    background: #12552e;
}

.add-activity-button span {
    font-size: 22px;
    line-height: 1;
}

.activity-form-section {
    margin-bottom: 28px;
}

.activity-form-card {
    background: #fff;
    border: 1px solid #e3e9e5;
    border-radius: 14px;
    box-shadow: 0 2px 10px rgba(20, 70, 45, 0.04);
    padding: 20px;
}

.form-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
}

.form-header h2 {
    margin: 0;
    font-size: 20px;
    color: #173b2a;
}

.close-form-button {
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: #f4f4f4;
    color: #555;
    font-size: 25px;
    cursor: pointer;
}

.form-group {
    margin-bottom: 17px;
}

.form-group > label {
    display: block;
    margin-bottom: 8px;
    font-size: 14px;
    color: #444;
}

.form-group input[type="text"] {
    width: 100%;
    height: 48px;
    border: 1px solid #ddd;
    border-radius: 10px;
    padding: 0 13px;
    outline: none;
    background: #fff;
    font-size: 15px;
}

.form-group input[type="text"]:focus {
    border-color: #176b3a;
}

.typed-date-wrapper {
    width: 100%;
    height: 48px;
    display: flex;
    align-items: stretch;
    border: 1px solid #ddd;
    border-radius: 10px;
    background: #fff;
    overflow: hidden;
    direction: rtl;
}

.typed-date-input {
    flex: 1;
    min-width: 0;
    border: 0 !important;
    outline: none;
    background: transparent;
    padding: 0 13px !important;
    font-size: 15px;
    color: #333;
    text-align: right;
    direction: rtl;
}

.calendar-icon-button {
    width: 48px;
    flex: 0 0 48px;
    border: 0;
    border-right: 1px solid #eee;
    background: #fff;
    cursor: pointer;
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.custom-date-popover {
    display: none;
    margin-top: 8px;
    width: 100%;
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 12px;
    padding: 12px;
    box-shadow: 0 10px 28px rgba(0,0,0,.14);
    position: relative;
    z-index: 20;
}

.custom-date-popover.open {
    display: block;
}

.date-picker-selects {
    display: grid;
    grid-template-columns: 1fr 1.4fr 1fr;
    gap: 8px;
}

.date-picker-selects select {
    height: 44px;
    border: 1px solid #ddd;
    border-radius: 9px;
    background: #fff;
    padding: 0 9px;
    font-size: 14px;
    color: #333;
    outline: none;
}

.date-picker-selects select:focus {
    border-color: #176b3a;
}

.member-search {
    height: 45px;
    border: 1px solid #ddd;
    border-radius: 10px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 12px;
}

.member-search span {
    font-size: 22px;
    color: #777;
}

.member-search input {
    border: none;
    outline: none;
    width: 100%;
    font-size: 14px;
    background: transparent;
}

.members-section {
    margin-top: 5px;
}

.members-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 10px;
}

.members-section-header h3 {
    margin: 0;
    font-size: 18px;
    color: #173b2a;
}

.members-section-header p {
    margin: 4px 0 0;
    color: #748078;
    font-size: 13px;
}

.select-all-button {
    border: 1px solid #176b3a;
    background: #fff;
    color: #176b3a;
    border-radius: 9px;
    min-height: 40px;
    padding: 0 13px;
    cursor: pointer;
    font: inherit;
}

.members-list {
    max-height: 360px;
    overflow-y: auto;
    border: 1px solid #eee;
    border-radius: 10px;
    -webkit-overflow-scrolling: touch;
}

.member-row {
    min-height: 58px;
    padding: 9px 13px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    border-bottom: 1px solid #f0f0f0;
}

.member-row:last-child {
    border-bottom: none;
}

.member-row:hover {
    background: #fafafa;
}

.member-row-info {
    display: flex;
    align-items: center;
    gap: 10px;
}

.member-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.member-row input {
    width: 19px;
    height: 19px;
    accent-color: #176b3a;
}

.save-activity-button {
    width: 100%;
    margin-top: 18px;
    height: 50px;
    border: none;
    border-radius: 10px;
    background: #176b3a;
    color: #fff;
    font-size: 16px;
    cursor: pointer;
}

.save-activity-button:hover {
    background: #12552e;
}

.save-activity-button:disabled {
    opacity: 0.6;
    cursor: wait;
}

.activities-list-section {
    margin-top: 10px;
}

.activities-list-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 12px;
}

.activities-list-header h2 {
    margin: 0;
    font-size: 20px;
    color: #222;
}

.year-filter {
    width: 130px;
    height: 45px;
    border: 1px solid #ddd;
    border-radius: 9px;
    padding: 0 14px;
    background: #fff;
    font-size: 15px;
    color: #333;
}

.activities-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.activity-card {
    width: 100%;
    border: 1px solid #e6e6e6;
    background: #fff;
    border-radius: 13px;
    padding: 18px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-align: right;
    cursor: pointer;
    transition: 0.15s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
}

.activity-card:hover {
    border-color: #176b3a;
    transform: translateY(-1px);
}

.activity-card-main {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.activity-card h3 {
    margin: 0 0 2px;
    font-size: 18px;
    color: #222;
}

.activity-info {
    display: flex;
    align-items: center;
    gap: 7px;
    color: #666;
    font-size: 14px;
}

.activity-arrow {
    font-size: 27px;
    color: #999;
}

.empty-state {
    padding: 45px 20px;
    text-align: center;
    color: #888;
    background: #fff;
    border: 1px dashed #ddd;
    border-radius: 12px;
}

@media (max-width: 640px) {

    .activities-topbar-inner {
        padding: 0 14px;
    }

    .activities-topbar-title {
        font-size: 18px;
    }

    .activities-page {
        padding: 20px 15px;
        padding-top: 96px;
    }

    .activities-header h1 {
        font-size: 22px;
    }

    .add-activity-button {
        width: 100%;
    }

    .activity-form-card {
        padding: 16px;
        border-radius: 12px;
    }

    .activities-list-header {
        align-items: flex-start;
    }

    .activities-list-header h2 {
        font-size: 19px;
    }

    .members-list {
        max-height: 330px;
    }

    .date-picker-selects {
        grid-template-columns: 1fr 1.35fr 1fr;
    }

    .date-picker-selects select {
        font-size: 13px;
    }
}

/* ============================================================
   ACTIVITY MODAL
   ============================================================ */

body.activity-modal-open {
  overflow: hidden;
}

.activity-modal {
  position: fixed;
  inset: 0;
  display: none;
  align-items: flex-end;
  justify-content: center;
  background: rgba(0, 0, 0, 0.45);
  z-index: 9999;
}

.activity-modal.active {
  display: flex;
}

.activity-modal-box {
  width: min(620px, 100%);
  height: 88vh;
  max-height: 88vh;
  background: #fff;
  border-radius: 20px 20px 0 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -8px 35px rgba(0, 0, 0, 0.18);
}

.activity-modal-header {
  position: relative;
  min-height: 58px;
  padding: 14px 22px;
  border-bottom: 1px solid #eee;
  display: flex;
  align-items: center;
  justify-content: center;
  direction: rtl;
  flex-shrink: 0;
}

.activity-modal-header h2 {
  margin: 0;
  font-size: 19px;
  color: #222;
}

.activity-modal-close {
  position: absolute;
  right: 18px;
  top: 50%;
  transform: translateY(-50%);
  width: 34px;
  height: 34px;
  border: 0;
  background: transparent;
  color: #777;
  font-size: 27px;
  line-height: 1;
  cursor: pointer;
}

.activity-modal-body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 18px 22px;
}

.required-mark {
  color: #b3261e;
  margin-right: 3px;
}

.member-search {
  height: 46px;
  border: 1px solid #ddd;
  border-radius: 10px;
  display: flex;
  align-items: center;
  direction: rtl;
  gap: 8px;
  padding: 0 12px;
  background: #fff;
  box-sizing: border-box;
}

.member-search:focus-within {
  border-color: #176b3a;
  box-shadow: 0 0 0 2px rgba(23, 107, 58, 0.08);
}

.member-search-icon {
  color: #888;
  font-size: 20px;
  line-height: 1;
  flex-shrink: 0;
}

.member-search input {
  flex: 1;
  min-width: 0;
  height: 100%;
  border: 0;
  outline: none;
  background: transparent;
  font: inherit;
  color: #222;
  text-align: right;
}

.members-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 10px;
}

.members-section-header strong {
  color: #222;
  font-size: 16px;
}

.members-section-header span {
  color: #777;
  font-size: 13px;
}

.members-list {
  max-height: 330px;
  overflow-y: auto;
  border: 1px solid #eee;
  border-radius: 10px;
}

.save-activity-button {
  margin: 14px 22px 20px;
  height: 50px;
  border: none;
  border-radius: 10px;
  background: #176b3a;
  color: #fff;
  font-size: 16px;
  cursor: pointer;
  flex-shrink: 0;
}

.save-activity-button:disabled {
  opacity: 0.65;
  cursor: wait;
}

.select-all-button {
  display: none !important;
}

/* ============================================================
   YEAR SECTION
   ============================================================ */

.activities-year-label {
  display: block;
  margin: 0 0 7px;
  font-size: 14px;
  color: #777;
}

.activities-year-filter {
  width: 130px;
  height: 45px;
  border: 1px solid #ddd;
  border-radius: 9px;
  padding: 0 14px;
  background: #fff;
  font-size: 15px;
  color: #333;
  margin-bottom: 18px;
}

@media (max-width: 600px) {
  .activity-modal-box {
    width: 100%;
    height: 90vh;
    max-height: 90vh;
    border-radius: 18px 18px 0 0;
  }

  .activity-modal-body {
    padding: 16px 15px;
  }

  .save-activity-button {
    margin: 12px 15px 17px;
  }

  .members-list {
    max-height: 300px;
  }
}

/* ============================================================
   ACTIVITIES MODAL
   MATCH MEETINGS MODAL DESIGN
   ============================================================ */

.activity-modal,
.activity-modal * {
  box-sizing: border-box;
}

body.activity-modal-open {
  overflow: hidden;
}

.activity-modal {
  position: fixed;
  inset: 0;
  display: none;
  align-items: flex-end;
  justify-content: center;
  background: rgba(0, 0, 0, 0.35);
  z-index: 9999;
  direction: rtl;
}

.activity-modal.active {
  display: flex;
}

.activity-modal-box {
  width: min(620px, 100%);
  height: 88vh;
  max-height: 88vh;
  background: #fff;
  border-radius: 20px 20px 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 -8px 30px rgba(0, 0, 0, 0.12);
}

/* Header — same structure/feeling as Meetings */

.activity-modal-box .form-header {
  position: relative;
  min-height: 58px;
  padding: 14px 22px;
  border-bottom: 1px solid #eee;
  display: flex;
  align-items: center;
  justify-content: center;
  direction: rtl;
  flex-shrink: 0;
  margin: 0;
}

.activity-modal-box .form-header h2 {
  margin: 0;
  font-size: 21px;
  font-weight: 700;
  color: #222;
  text-align: center;
}

.activity-modal-box .close-form-button {
  position: absolute;
  left: 18px;
  right: auto;
  top: 50%;
  transform: translateY(-50%);
  width: 36px;
  height: 36px;
  min-width: 36px;
  border: none;
  background: #f4f4f4;
  border-radius: 50%;
  color: #555;
  font-size: 25px;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.activity-modal-box .close-form-button:hover {
  background: #e9e9e9;
}

/* Body */

.activity-modal-box > .activity-modal-body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 18px 22px;
}

/* If the body wrapper is not present, keep modal content safe */

.activity-modal-box > .form-group,
.activity-modal-box > .members-section {
  margin-left: 22px;
  margin-right: 22px;
}

/* Form groups */

.activity-modal-box .form-group {
  width: 100%;
  min-width: 0;
  margin-bottom: 14px;
}

.activity-modal-box .form-group label {
  display: block;
  margin-bottom: 8px;
  font-size: 14px;
  color: #444;
  font-weight: 500;
}

/* Text input */

.activity-modal-box .form-group input[type="text"] {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  height: 48px;
  border: 1px solid #ddd;
  border-radius: 10px;
  padding: 0 12px;
  outline: none;
  background: #fff;
  font-size: 14px;
  color: #222;
}

.activity-modal-box .form-group input[type="text"]:focus {
  border-color: #176b3a;
  box-shadow: 0 0 0 2px rgba(23, 107, 58, 0.08);
}

/* Date */

.activity-modal-box .typed-date-wrapper {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  height: 48px;
  border: 1px solid #ddd;
  border-radius: 10px;
  display: flex;
  align-items: center;
  overflow: hidden;
  background: #fff;
}

.activity-modal-box .typed-date-input {
  flex: 1;
  min-width: 0;
  width: 100%;
  height: 100%;
  border: none !important;
  outline: none;
  padding: 0 12px;
  background: transparent;
  font-size: 14px;
}

.activity-modal-box .calendar-icon-button {
  width: 48px;
  height: 100%;
  flex-shrink: 0;
  border: none;
  border-right: 1px solid #eee;
  background: #fff;
  cursor: pointer;
  font-size: 18px;
}

/* Search */

.activity-modal-box .member-search {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  height: 48px;
  border: 1px solid #ddd;
  border-radius: 10px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 12px;
  margin: 0;
  overflow: hidden;
}

.activity-modal-box .member-search span,
.activity-modal-box .member-search-icon {
  flex-shrink: 0;
  font-size: 20px;
  color: #888;
}

.activity-modal-box .member-search input {
  flex: 1;
  min-width: 0;
  width: 100%;
  height: 100%;
  border: none;
  outline: none;
  background: transparent;
  font-size: 14px;
}

/* Members */

.activity-modal-box .members-section {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  margin-top: 4px;
  margin-bottom: 0;
}

.activity-modal-box .members-section-header {
  width: 100%;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 10px;
}

.activity-modal-box .members-section-header > div {
  min-width: 0;
}

.activity-modal-box .members-section-header h3,
.activity-modal-box .members-section-header strong {
  margin: 0;
  font-size: 18px;
  color: #222;
}

.activity-modal-box .members-section-header p,
.activity-modal-box .members-section-header span {
  margin: 4px 0 0;
  color: #777;
  font-size: 13px;
}

/* Member list — contained inside phone width */

.activity-modal-box .members-list {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  max-height: 330px;
  overflow-y: auto;
  overflow-x: hidden;
  border: 1px solid #eee;
  border-radius: 10px;
  background: #fff;
  -webkit-overflow-scrolling: touch;
}

.activity-modal-box .member-row {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  min-height: 58px;
  padding: 9px 13px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  border-bottom: 1px solid #f0f0f0;
  overflow: hidden;
}

.activity-modal-box .member-row:last-child {
  border-bottom: none;
}

.activity-modal-box .member-row-info {
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10px;
  overflow: hidden;
}

.activity-modal-box .member-row-info > div:last-child {
  min-width: 0;
  overflow: hidden;
}

.activity-modal-box .member-row-info strong,
.activity-modal-box .member-row-info span {
  max-width: 100%;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.activity-modal-box .member-avatar {
  width: 38px;
  height: 38px;
  min-width: 38px;
  flex-shrink: 0;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.activity-modal-box .member-row input {
  width: 19px;
  height: 19px;
  min-width: 19px;
  flex-shrink: 0;
  accent-color: #176b3a;
}

/* Save — same proportions as Meetings */

.activity-modal-box .save-activity-button {
  width: auto;
  margin: 14px 22px 20px;
  height: 50px;
  min-height: 50px;
  flex-shrink: 0;
  border: none;
  border-radius: 10px;
  background: #176b3a;
  color: white;
  font-size: 16px;
  font-weight: 700;
  cursor: pointer;
}

.activity-modal-box .save-activity-button:hover {
  background: #12552e;
}

.activity-modal-box .save-activity-button:disabled {
  opacity: 0.6;
  cursor: wait;
}

/* Date picker stays inside modal width */

.activity-modal-box .custom-date-popover {
  max-width: 100%;
  box-sizing: border-box;
}

/* Mobile — same spacing as Meetings */

@media (max-width: 640px) {

  .activity-modal-box {
    width: 100%;
    height: 88vh;
    max-height: 88vh;
    border-radius: 20px 20px 0 0;
  }

  .activity-modal-box .form-header {
    min-height: 58px;
    padding: 14px 18px;
  }

  .activity-modal-box .close-form-button {
    left: 18px;
  }

  .activity-modal-box > .activity-modal-body {
    padding: 12px 18px;
  }

  .activity-modal-box > .form-group,
  .activity-modal-box > .members-section {
    margin-left: 18px;
    margin-right: 18px;
  }

  .activity-modal-box .save-activity-button {
    margin: 12px 18px 18px;
  }

  .activity-modal-box .members-list {
    max-height: 300px;
  }
}

/* =========================================================
   ACTIVITY MODAL - FINAL MOBILE LAYOUT
   Match Meetings modal behavior:
   - Header stays visible
   - Middle content scrolls
   - Save button stays visible
   - Safe side spacing on phones
   ========================================================= */

.activity-modal {
    position: fixed;
    inset: 0;
    display: none;
    align-items: flex-end;
    justify-content: center;
    z-index: 9999;
    overflow: hidden;
}

.activity-modal.active {
    display: flex;
}

.activity-modal-box {
    width: min(620px, 100%);
    height: 88vh;
    max-height: 88vh;
    background: #fff;
    border-radius: 20px 20px 0 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-sizing: border-box;
}

/* ---------- HEADER ---------- */

.activity-modal-box .form-header {
    position: relative;
    min-height: 66px;
    flex-shrink: 0;
    padding: 20px 22px 14px;
    border-bottom: 1px solid #eee;
    display: flex;
    align-items: center;
    justify-content: center;
    direction: rtl;
    box-sizing: border-box;
}

.activity-modal-box .form-header h2 {
    margin: 5px 0 0;
    font-size: 21px;
    line-height: 1.3;
    text-align: center;
}

.activity-modal-box .close-form-button {
    position: absolute;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    width: 36px;
    height: 36px;
    border: none;
    background: #f4f4f4;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
}

/* ---------- SCROLLABLE MIDDLE ---------- */

.activity-modal-box .form-group,
.activity-modal-box .members-section {
    flex-shrink: 0;
}

.activity-modal-box .form-group {
    margin-left: 22px;
    margin-right: 22px;
}

.activity-modal-box .members-section {
    margin-left: 22px;
    margin-right: 22px;
}

/* Put the middle content into a flexible scrolling area
   using the existing direct children. */
.activity-modal-box > .form-group:first-of-type {
    margin-top: 14px;
}

.activity-modal-box {
    overflow-y: auto;
}

/* Header and save button must not scroll away */
.activity-modal-box .form-header,
.activity-modal-box .save-activity-button {
    position: sticky;
    z-index: 5;
    background: #fff;
}

.activity-modal-box .form-header {
    top: 0;
}

.activity-modal-box .save-activity-button {
    bottom: 0;
    flex-shrink: 0;
    margin: 12px 22px 18px;
    min-height: 50px;
    height: 50px;
    border: none;
    border-radius: 10px;
    background: #176b3a;
    color: #fff;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    box-sizing: border-box;
}

/* ---------- INPUTS ---------- */

.activity-modal-box input,
.activity-modal-box select {
    box-sizing: border-box;
    max-width: 100%;
}

.activity-modal-box .form-group label {
    display: block;
    margin-bottom: 8px;
}

.activity-modal-box .typed-date-wrapper,
.activity-modal-box .member-search {
    width: 100%;
    box-sizing: border-box;
}

.activity-modal-box .typed-date-input,
.activity-modal-box .member-search input,
.activity-modal-box #activityTitle {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
}

/* ---------- MEMBERS ---------- */

.activity-modal-box .members-list {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    overflow-x: hidden;
}

.activity-modal-box .member-row {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    overflow: hidden;
}

.activity-modal-box .member-row * {
    min-width: 0;
}

.activity-modal-box .member-row span,
.activity-modal-box .member-row strong,
.activity-modal-box .member-row label {
    overflow-wrap: anywhere;
    word-break: break-word;
}

/* ---------- MOBILE ---------- */

@media (max-width: 640px) {

    .activity-modal {
        align-items: flex-end;
    }

    .activity-modal-box {
        width: 100%;
        height: 88vh;
        max-height: 88vh;
        border-radius: 20px 20px 0 0;
    }

    .activity-modal-box .form-header {
        min-height: 68px;
        padding: 22px 18px 14px;
    }

    .activity-modal-box .form-header h2 {
        margin-top: 6px;
        font-size: 20px;
    }

    .activity-modal-box .close-form-button {
        left: 18px;
    }

    .activity-modal-box .form-group {
        margin-left: 18px;
        margin-right: 18px;
    }

    .activity-modal-box .members-section {
        margin-left: 18px;
        margin-right: 18px;
    }

    .activity-modal-box .save-activity-button {
        margin: 12px 18px 18px;
        min-height: 50px;
        height: 50px;
    }
}

/* Very narrow phones */
@media (max-width: 380px) {

    .activity-modal-box .form-group {
        margin-left: 16px;
        margin-right: 16px;
    }

    .activity-modal-box .members-section {
        margin-left: 16px;
        margin-right: 16px;
    }

    .activity-modal-box .save-activity-button {
        margin-left: 16px;
        margin-right: 16px;
    }
}

