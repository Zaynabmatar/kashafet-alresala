    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2">
/* =========================================================
   CUSTOM ARABIC BIRTH DATE PICKER
========================================================= */

(function setupArabicBirthDatePicker() {

  const input = document.getElementById("birthDateInput");
  const hidden = document.getElementById("birthDateValue");
  const picker = document.getElementById("birthDatePicker");
  const calendar = document.getElementById("birthCalendar");
  const calendarButton = document.getElementById("birthCalendarButton");
  const calendarTitle = document.getElementById("birthCalendarTitle");
  const calendarDays = document.getElementById("birthCalendarDays");
  const prevButton = document.getElementById("birthPrevMonth");
  const nextButton = document.getElementById("birthNextMonth");

  if (
    !input ||
    !hidden ||
    !picker ||
    !calendar ||
    !calendarButton ||
    !calendarTitle ||
    !calendarDays ||
    !prevButton ||
    !nextButton
  ) {
    return;
  }

  const arabicMonths = [
    "كانون الثاني",
    "شباط",
    "آذار",
    "نيسان",
    "أيار",
    "حزيران",
    "تموز",
    "آب",
    "أيلول",
    "تشرين الأول",
    "تشرين الثاني",
    "كانون الأول"
  ];

  const arabicDigits = ["٠","١","٢","٣","٤","٥","٦","٧","٨","٩"];

  let calendarYear = new Date().getFullYear();
  let calendarMonth = new Date().getMonth();

  function toArabicDigits(value) {
    return String(value).replace(/[0-9]/g, function(digit) {
      return arabicDigits[Number(digit)];
    });
  }

  function toEnglishDigits(value) {
    return String(value)
      .replace(/[٠-٩]/g, function(digit) {
        return String("٠١٢٣٤٥٦٧٨٩".indexOf(digit));
      })
      .replace(/[۰-۹]/g, function(digit) {
        return String("۰۱۲۳۴۵۶۷۸۹".indexOf(digit));
      });
  }

  function formatVisibleDate(year, month, day) {
    return (
      toArabicDigits(String(day).padStart(2, "0")) +
      "/" +
      toArabicDigits(String(month + 1).padStart(2, "0")) +
      "/" +
      toArabicDigits(year)
    );
  }

  function setDate(year, month, day) {
    const monthValue = String(month + 1).padStart(2, "0");
    const dayValue = String(day).padStart(2, "0");

    hidden.value = `${year}-${monthValue}-${dayValue}`;

    input.value = formatVisibleDate(year, month, day);

    calendarYear = year;
    calendarMonth = month;

    renderCalendar();
  }

  function clearDate() {
    input.value = "";
    hidden.value = "";
  }

  function renderCalendar() {

    calendarTitle.textContent =
      arabicMonths[calendarMonth] +
      " " +
      toArabicDigits(calendarYear);

    calendarDays.innerHTML = "";

    const firstDay = new Date(calendarYear, calendarMonth, 1).getDay();
    const daysInMonth = new Date(
      calendarYear,
      calendarMonth + 1,
      0
    ).getDate();

    const selectedDate = hidden.value
      ? hidden.value.split("-")
      : null;

    const selectedYear = selectedDate ? Number(selectedDate[0]) : null;
    const selectedMonth = selectedDate ? Number(selectedDate[1]) - 1 : null;
    const selectedDay = selectedDate ? Number(selectedDate[2]) : null;

    for (let i = 0; i < firstDay; i++) {
      const empty = document.createElement("button");
      empty.type = "button";
      empty.className = "empty";
      empty.tabIndex = -1;
      calendarDays.appendChild(empty);
    }

    for (let day = 1; day <= daysInMonth; day++) {

      const button = document.createElement("button");

      button.type = "button";
      button.textContent = toArabicDigits(day);

      if (
        selectedYear === calendarYear &&
        selectedMonth === calendarMonth &&
        selectedDay === day
      ) {
        button.classList.add("selected");
      }

      const today = new Date();

      if (
        today.getFullYear() === calendarYear &&
        today.getMonth() === calendarMonth &&
        today.getDate() === day
      ) {
        button.classList.add("today");
      }

      button.addEventListener("click", function() {
        setDate(calendarYear, calendarMonth, day);
        calendar.classList.remove("open");
      });

      calendarDays.appendChild(button);
    }
  }

  function openCalendar() {
    if (hidden.value) {
      const parts = hidden.value.split("-");

      if (parts.length === 3) {
        calendarYear = Number(parts[0]);
        calendarMonth = Number(parts[1]) - 1;
      }
    }

    renderCalendar();
    calendar.classList.add("open");
  }

  function parseManualDate() {

    let value = toEnglishDigits(input.value.trim());

    if (!value) {
      clearDate();
      return;
    }

    value = value.replace(/[.\-]/g, "/");

    const parts = value.split("/");

    if (parts.length !== 3) {
      hidden.value = "";
      return;
    }

    const day = Number(parts[0]);
    const month = Number(parts[1]);
    const year = Number(parts[2]);

    if (
      !Number.isInteger(day) ||
      !Number.isInteger(month) ||
      !Number.isInteger(year) ||
      year < 1940 ||
      year > new Date().getFullYear() ||
      month < 1 ||
      month > 12 ||
      day < 1 ||
      day > new Date(year, month, 0).getDate()
    ) {
      hidden.value = "";
      return;
    }

    hidden.value =
      `${year}-${String(month).padStart(2, "0")}-${String(day).padStart(2, "0")}`;

    input.value = formatVisibleDate(year, month - 1, day);

    calendarYear = year;
    calendarMonth = month - 1;
  }

  input.addEventListener("input", function() {

    let value = input.value;

    value = value.replace(/[^\d٠-٩۰-۹/.-]/g, "");

    input.value = value;
    hidden.value = "";
  });

  input.addEventListener("blur", function() {
    parseManualDate();
  });

  input.addEventListener("keydown", function(event) {

    if (event.key === "Enter") {
      event.preventDefault();
      parseManualDate();
      calendar.classList.remove("open");
    }

    if (event.key === "Escape") {
      calendar.classList.remove("open");
    }
  });

  calendarButton.addEventListener("click", function(event) {
    event.preventDefault();
    event.stopPropagation();
    openCalendar();
  });

  prevButton.addEventListener("click", function() {

    calendarMonth--;

    if (calendarMonth < 0) {
      calendarMonth = 11;
      calendarYear--;
    }

    if (calendarYear < 1940) {
      calendarYear = 1940;
      calendarMonth = 0;
    }

    renderCalendar();
  });

  nextButton.addEventListener("click", function() {

    calendarMonth++;

    if (calendarMonth > 11) {
      calendarMonth = 0;
      calendarYear++;
    }

    if (calendarYear > new Date().getFullYear()) {
      calendarYear = new Date().getFullYear();
      calendarMonth = new Date().getMonth();
    }

    renderCalendar();
  });

  document.addEventListener("click", function(event) {

    if (!picker.contains(event.target)) {
      calendar.classList.remove("open");
    }

  });

  input.addEventListener("focus", function() {
    if (!input.value) {
      calendarYear = new Date().getFullYear();
      calendarMonth = new Date().getMonth();
    }
  });

})();
</script>
