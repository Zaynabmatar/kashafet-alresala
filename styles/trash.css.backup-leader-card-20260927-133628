.trash-container {
  width: min(1180px, calc(100% - 32px));
  height: calc(100vh - 110px);
  margin: 0 auto;
  padding: 28px 0 24px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.trash-header {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 18px;
}

.trash-header h1 {
  margin: 0 0 7px;
  color: #1f2d25;
  font-size: 28px;
  line-height: 1.25;
}

.trash-header p {
  margin: 0;
  color: #68756e;
  font-size: 14px;
  line-height: 1.7;
}

.trash-total {
  min-width: 120px;
  padding: 12px 18px;
  background: #fff;
  border: 1px solid #e1e8e3;
  border-radius: 14px;
  text-align: center;
  flex: 0 0 auto;
}

.trash-total span {
  display: block;
  margin-bottom: 4px;
  color: #68756e;
  font-size: 12px;
}

.trash-total strong {
  color: #225d3c;
  font-size: 24px;
  line-height: 1;
}

.trash-list {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
  display: grid;
  align-content: start;
  gap: 12px;
  padding: 2px 8px 12px 2px;
  scrollbar-width: thin;
}

.trash-card {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 15px 17px;
  background: #fff;
  border: 1px solid #e1e8e3;
  border-radius: 14px;
  box-shadow: 0 4px 14px rgba(31, 45, 37, 0.055);
}

.trash-card-info {
  min-width: 0;
  flex: 1 1 auto;
  display: flex;
  align-items: center;
  gap: 14px;
}

.trash-avatar {
  width: 54px;
  height: 54px;
  flex: 0 0 54px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 50%;
  background: #eef4f0;
  font-size: 23px;
}

.trash-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.trash-details {
  min-width: 0;
  flex: 1 1 auto;
}

.trash-details h3 {
  margin: 0 0 6px;
  overflow: hidden;
  color: #1f2d25;
  font-size: 16px;
  font-weight: 700;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.trash-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 6px 16px;
  color: #5e6b64;
  font-size: 12px;
  line-height: 1.5;
}

.deleted-date {
  margin: 5px 0 0;
  color: #929b96;
  font-size: 11px;
  line-height: 1.4;
}

.restore-button {
  flex: 0 0 auto;
  min-width: 92px;
  height: 40px;
  border: none;
  border-radius: 9px;
  background: #225d3c;
  color: #fff;
  padding: 0 15px;
  font-family: inherit;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.2s ease, transform 0.2s ease;
}

.restore-button:hover {
  background: #17472d;
}

.restore-button:active {
  transform: translateY(1px);
}

.trash-empty {
  flex: 1 1 auto;
  min-height: 0;
  padding: 55px 20px;
  box-sizing: border-box;
  background: #fff;
  border: 1px solid #e1e8e3;
  border-radius: 16px;
  text-align: center;
  color: #7a867f;
}

.trash-empty h2 {
  margin: 12px 0 7px;
  color: #1f2d25;
  font-size: 20px;
}

.trash-empty p {
  margin: 0;
  font-size: 13px;
}

@media (max-width: 850px) {
  .trash-container {
    height: auto;
    min-height: calc(100vh - 100px);
  }

  .trash-list {
    overflow: visible;
  }

  .trash-card {
    align-items: stretch;
    flex-direction: column;
  }

  .restore-button {
    width: 100%;
  }
}

@media (max-width: 600px) {
  .trash-container {
    width: calc(100% - 24px);
    padding-top: 20px;
  }

  .trash-header {
    align-items: stretch;
    flex-direction: column;
    gap: 14px;
  }

  .trash-header h1 {
    font-size: 23px;
  }

  .trash-header p {
    font-size: 13px;
  }

  .trash-total {
    width: 100%;
    box-sizing: border-box;
  }

  .trash-card {
    padding: 14px;
  }

  .trash-card-info {
    align-items: flex-start;
  }

  .trash-avatar {
    width: 48px;
    height: 48px;
    flex-basis: 48px;
  }

  .trash-details h3 {
    font-size: 15px;
  }

  .trash-meta {
    flex-direction: column;
    gap: 4px;
  }
}
