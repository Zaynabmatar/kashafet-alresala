.meetings-page {
  padding: 30px;
  max-width: 1100px;
  margin: 0 auto;
}

/* =========================
   Header
========================= */

.meetings-header {
  margin-bottom: 24px;
}

.add-meeting-button {
  border: none;
  background: #176b3a;
  color: white;
  padding: 13px 22px;
  border-radius: 10px;
  font-size: 16px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 52px;
}

.add-meeting-button:hover {
  background: #12552e;
}

.add-meeting-button span {
  font-size: 22px;
  line-height: 1;
}

/* =========================
   Meetings list
========================= */

.year-section {
  margin: 0 0 22px;
}

.year-filter {
  width: 130px;
  height: 45px;
  border: 1px solid #ddd;
  border-radius: 9px;
  padding: 0 14px;
  background: white;
  font-size: 15px;
  color: #333;
}

.meetings-list-section h2 {
  margin: 0 0 12px;
  font-size: 20px;
  color: #222;
}

.meetings-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.meeting-card {
  width: 100%;
  border: 1px solid #e6e6e6;
  background: white;
  border-radius: 13px;
  padding: 18px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  text-align: right;
  cursor: pointer;
  transition: 0.15s ease;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
}

.meeting-card:hover {
  border-color: #176b3a;
  transform: translateY(-1px);
}

.meeting-card-main {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.meeting-card h3 {
  margin: 0 0 2px;
  font-size: 18px;
  color: #222;
}

.meeting-info {
  display: flex;
  align-items: center;
  gap: 7px;
  color: #666;
  font-size: 14px;
}

.meeting-arrow {
  font-size: 27px;
  color: #999;
}

.empty-state {
  padding: 45px 20px;
  text-align: center;
  color: #888;
  background: white;
  border: 1px dashed #ddd;
  border-radius: 12px;
}

/* =========================
   Meeting details
========================= */

.details-header,
.attendees-details-section {
  background: #fff;
  border: 1px solid #e3e9e5;
  border-radius: 14px;
  box-shadow: 0 2px 10px rgba(20, 70, 45, 0.04);
}

.details-header {
  padding: 22px;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18px;
  margin-bottom: 18px;
}

.details-header h1 {
  margin: 0;
  font-size: 23px;
  color: #173b2a;
}

.details-back {
  border: 0;
  background: transparent;
  color: #176b3a;
  font: inherit;
  cursor: pointer;
  padding: 3px 0;
  white-space: nowrap;
}

.details-date {
  margin-top: 9px;
  color: #68756e;
  display: flex;
  align-items: center;
  gap: 7px;
}

.attendees-details-section {
  padding: 20px;
}

.details-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  margin-bottom: 16px;
}

.details-section-header h2 {
  margin: 0;
  font-size: 20px;
  color: #173b2a;
}

.details-section-header p {
  margin: 5px 0 0;
  color: #748078;
  font-size: 14px;
}

.add-attendee-button {
  border: 1px solid #176b3a;
  border-radius: 9px;
  background: #176b3a;
  color: #fff;
  min-height: 42px;
  padding: 0 14px;
  font: inherit;
  cursor: pointer;
  white-space: nowrap;
}

.add-attendee-button:hover {
  background: #12552e;
}

.present-leaders-list {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
  gap: 10px;
}

.present-leader-card {
  min-height: 56px;
  border: 1px solid #e1e8e3;
  border-radius: 10px;
  padding: 9px 12px;
  display: flex;
  align-items: center;
  gap: 10px;
  background: #fbfdfb;
}

/* =========================
   Topbar
========================= */

.meetings-topbar {
  height: 76px;
  display: flex;
  align-items: center;
  padding: 0 24px;
  background: #176b3a;
  border-bottom: 1px solid #176b3a;
  direction: rtl;
}

.meetings-topbar .user-area {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.meetings-topbar .menu-button {
  width: 42px;
  height: 42px;
  border: none;
  background: transparent;
  color: white;
  font-size: 28px;
  line-height: 1;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

.meetings-topbar .menu-button:hover {
  background: rgba(255, 255, 255, 0.12);
  border-radius: 50%;
}

/* =========================
   Modal
========================= */

.meeting-modal {
  position: fixed;
  inset: 0;
  display: none;
  align-items: flex-end;
  justify-content: center;
  padding: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 9999;
}

.meeting-modal.active {
  display: flex;
}

.meeting-modal-box {
  width: min(620px, 100%);
  height: 88vh;
  max-height: 88vh;
  background: white;
  border-radius: 20px 20px 0 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -8px 35px rgba(0, 0, 0, 0.18);
}

/* =========================
   Modal header
========================= */

.meeting-modal-header {
  position: relative;
  min-height: 58px;
  padding: 14px 22px;
  border-bottom: 1px solid #eee;
  display: flex;
  align-items: center;
  justify-content: center;
  direction: rtl;
  box-sizing: border-box;
  flex-shrink: 0;
}

.meeting-modal-header h2 {
  margin: 0;
  font-size: 21px;
  text-align: center;
}

.close-modal-button {
  position: absolute;
  left: 18px;
  top: 50%;
  transform: translateY(-50%);
  width: 36px;
  height: 36px;
  border: none;
  background: #f4f4f4;
  border-radius: 50%;
  font-size: 25px;
  cursor: pointer;
  color: #555;
  z-index: 2;
}

.close-modal-button:hover {
  background: #e9e9e9;
}

/* =========================
   Date
========================= */

.meeting-date-section {
  padding: 14px 22px 10px;
  flex-shrink: 0;
}

.meeting-date-section label {
  display: block;
  margin-bottom: 8px;
  font-size: 14px;
  color: #444;
}

.meeting-date-section input[type="date"] {
  height: 48px;
  border: 1px solid #ddd;
  border-radius: 10px;
  padding: 0 12px;
  outline: none;
  width: 100%;
  font-size: 15px;
  background: white;
  color: #333;
  box-sizing: border-box;
}

/* =========================
   Leaders / Search
========================= */

.attendees-section {
  padding: 8px 22px 14px;
  display: flex;
  flex-direction: column;
  min-height: 0;
  overflow: hidden;
  flex: 1;
}

.leader-search {
  height: 45px;
  border: 1px solid #ddd;
  border-radius: 10px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 12px;
  margin-bottom: 10px;
  flex-shrink: 0;
}

.leader-search span {
  font-size: 22px;
  color: #777;
}

.leader-search input {
  border: none;
  outline: none;
  width: 100%;
  font-size: 14px;
  background: transparent;
}

.leaders-list {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
  border: 1px solid #eee;
  border-radius: 10px;
  -webkit-overflow-scrolling: touch;
}

.leader-row {
  min-height: 58px;
  padding: 9px 13px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
  border-bottom: 1px solid #f0f0f0;
  box-sizing: border-box;
}

.leader-row:last-child {
  border-bottom: none;
}

.leader-row:hover {
  background: #fafafa;
}

.leader-row-info {
  display: flex;
  align-items: center;
  gap: 10px;
}

.leader-avatar {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.leader-row input {
  width: 19px;
  height: 19px;
  accent-color: #176b3a;
}

.no-leaders {
  padding: 25px;
  text-align: center;
  color: #888;
}

/* =========================
   Save
========================= */

.save-meeting-button {
  margin: 14px 22px 20px;
  height: 50px;
  border: none;
  border-radius: 10px;
  background: #176b3a;
  color: white;
  font-size: 16px;
  cursor: pointer;
  flex-shrink: 0;
}

.save-meeting-button:hover {
  background: #12552e;
}

.save-meeting-button:disabled {
  opacity: 0.6;
  cursor: wait;
}

/* =========================
   Mobile
========================= */

@media (max-width: 640px) {
  .meetings-page {
    padding: 20px 15px;
  }

  .meetings-topbar {
    padding: 0 14px;
  }

  .add-meeting-button {
    width: 100%;
  }

  .meeting-modal {
    align-items: flex-end;
  }

  .meeting-modal-box {
    width: 100%;
    height: 88vh;
    max-height: 88vh;
    border-radius: 20px 20px 0 0;
  }

  .meeting-modal-header {
    padding: 14px 18px;
  }

  .close-modal-button {
    left: 18px;
  }

  .meeting-date-section {
    padding: 12px 18px 8px;
  }

  .attendees-section {
    padding: 8px 18px 12px;
  }

  .save-meeting-button {
    margin: 12px 18px 18px;
  }

  .details-header,
  .attendees-details-section {
    padding: 16px;
    border-radius: 12px;
  }

  .details-header h1 {
    font-size: 20px;
  }

  .details-section-header {
    align-items: flex-start;
  }

  .add-attendee-button {
    min-height: 39px;
    padding: 0 11px;
    font-size: 14px;
  }

  .present-leaders-list {
    grid-template-columns: 1fr;
  }
}

/* =========================
   Custom meeting date picker
========================= */

.custom-date-picker {
  position: relative;
  width: 100%;
}

.custom-date-trigger {
  width: 100%;
  min-height: 48px;
  border: 1px solid #ddd;
  border-radius: 10px;
  padding: 0 12px;
  background: #fff;
  display: flex;
  align-items: center;
  gap: 9px;
  font-size: 15px;
  color: #333;
  cursor: pointer;
  text-align: right;
}

.custom-date-trigger:hover {
  border-color: #bbb;
}

.custom-date-trigger #meetingDateDisplay {
  flex: 1;
}

.date-picker-chevron {
  font-size: 18px;
  color: #777;
  line-height: 1;
}

.custom-date-popover {
  display: none;
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  left: 0;
  background: #fff;
  border: 1px solid #ddd;
  border-radius: 12px;
  padding: 12px;
  box-shadow: 0 10px 28px rgba(0,0,0,.14);
  z-index: 10001;
}

.custom-date-popover.open {
  display: block;
}

.date-picker-selects {
  display: grid;
  grid-template-columns: 1fr 1.4fr 1fr;
  gap: 8px;
}

.date-picker-selects select {
  height: 44px;
  border: 1px solid #ddd;
  border-radius: 9px;
  background: #fff;
  padding: 0 9px;
  font-size: 14px;
  color: #333;
  outline: none;
}

.date-picker-selects select:focus {
  border-color: #176b3a;
}

@media (max-width: 640px) {

  .date-picker-selects {
    grid-template-columns: 1fr 1.35fr 1fr;
  }

  .date-picker-selects select {
    font-size: 13px;
  }
}


/* Typed Arabic date input */

.typed-date-wrapper {
  width: 100%;
  height: 48px;
  display: flex;
  align-items: stretch;
  border: 1px solid #ddd;
  border-radius: 10px;
  background: #fff;
  overflow: hidden;
  direction: rtl;
}

.typed-date-input {
  flex: 1;
  min-width: 0;
  border: 0;
  outline: none;
  background: transparent;
  padding: 0 13px;
  font-size: 15px;
  color: #333;
  text-align: right;
  direction: rtl;
}

.typed-date-input::placeholder {
  color: #999;
}

.calendar-icon-button {
  width: 48px;
  flex: 0 0 48px;
  border: 0;
  border-right: 1px solid #eee;
  background: #fff;
  cursor: pointer;
  font-size: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.calendar-icon-button:hover {
  background: #f7f7f7;
}





/* ============================================================
   MEETINGS TOPBAR - CONTENT STARTS BELOW HEADER
   ============================================================ */

body:has(.meetings-topbar) {
  padding-top: 64px;
  box-sizing: border-box;
}

.meetings-topbar {
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  right: 0 !important;
  width: 100% !important;
  z-index: 1000 !important;
  box-sizing: border-box !important;
}

/* =========================================================
   INTERNAL PAGE TOPBAR TITLE
========================================================= */

.topbar .user-area {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    position: relative;
}

.topbar .page-topbar-title {
    position: static;
    transform: none;

    margin-right: 0;
    margin-left: 8px;

    white-space: nowrap;

    font-size: 20px;
    font-weight: 700;

    color: #ffffff;

    pointer-events: none;
}

@media (max-width: 640px) {

    .topbar .page-topbar-title {
        margin-left: 7px;
        font-size: 18px;
    }
}


/* =========================================================
   Meetings header — one horizontal row
   ========================================================= */

.meetings-list-section-header {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 18px;
  direction: rtl;
}

.meetings-list-section-header h2 {
  margin: 0;
  flex: 0 0 auto;
  text-align: right;
}

.meetings-list-section-header .year-section {
  margin: 0;
  margin-inline-start: auto;
  flex: 0 0 auto;
}

.meetings-list-section-header .year-filter {
  margin: 0;
}


/* =========================================================
   Meeting card — preserve full card appearance
   ========================================================= */

.meeting-card {
  direction: rtl;
  text-align: right;
}

.meeting-card-main {
  flex: 1 1 auto;
  min-width: 0;
  text-align: right;
}


/* =========================================================
   Tiny left chevron
   ========================================================= */

.meeting-arrow {
  flex: 0 0 18px;
  width: 18px;
  height: 18px;
  margin-inline-start: 16px;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 16px;
  line-height: 1;
  color: #999;

  direction: ltr;
}


/* =========================================================
   Mobile — keep heading + combo on SAME ROW
   ========================================================= */

@media (max-width: 600px) {
  .meetings-list-section-header {
    width: 100%;
    gap: 12px;
  }

  .meetings-list-section-header h2 {
    white-space: nowrap;
    font-size: 18px;
  }

  .meetings-list-section-header .year-section {
    margin-inline-start: auto;
  }

  .meetings-list-section-header .year-filter {
    width: 115px;
  }

  .meeting-arrow {
    flex-basis: 16px;
    width: 16px;
    height: 16px;
    margin-inline-start: 10px;
    font-size: 15px;
  }
}

/* =========================================================
   MEETINGS HEADER + SCROLL FINAL FIX
   ========================================================= */

.meetings-list-section {
  width: 100%;
  overflow: visible;
}

.meetings-list-section-header {
  width: 100%;
  display: flex !important;
  flex-direction: row !important;
  align-items: center !important;
  justify-content: space-between !important;
  flex-wrap: nowrap !important;
  gap: 20px;
  margin-bottom: 18px;
  direction: rtl;
}

.meetings-list-section-header h2 {
  margin: 0 !important;
  flex: 0 0 auto !important;
  white-space: nowrap !important;
  text-align: right !important;
}

.meetings-list-section-header .year-section {
  margin: 0 0 0 auto !important;
  padding: 0 !important;
  flex: 0 0 auto !important;
  display: block !important;
}

.meetings-list-section-header .year-filter {
  margin: 0 !important;
  display: block !important;
}


/* قائمة الاجتماعات نفسها لا تنقص ولا تنقطع */
.meetings-list {
  width: 100%;
  overflow: visible !important;
}


/* إذا كانت الصفحة تستخدم حاوية قابلة للتمرير،
   لا نسمح لقسم الاجتماعات بإلغاء الـ scroll */
.meetings-page {
  overflow-y: auto !important;
  overflow-x: hidden !important;
}


/* لا تسمح لأي wrapper مباشر بإخفاء القائمة */
.meetings-page,
.meetings-list-section,
.meetings-list {
  min-height: 0;
}


/* Mobile: يبقوا بنفس السطر */
@media (max-width: 600px) {
  .meetings-list-section-header {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 12px;
  }

  .meetings-list-section-header h2 {
    white-space: nowrap !important;
    font-size: 18px;
  }

  .meetings-list-section-header .year-section {
    margin-inline-start: auto !important;
  }

  .meetings-list-section-header .year-filter {
    width: 115px;
  }
}
