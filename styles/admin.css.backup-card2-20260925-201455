/* TRASH-SYSTEM-CSS */

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.trash-button,
.back-to-leaders-button {
  border: 1px solid rgba(255,255,255,0.45);
  background: transparent;
  color: #fff;
  border-radius: 8px;
  padding: 9px 14px;
  font-size: 13px;
  font-family: inherit;
  cursor: pointer;
  transition: 0.2s ease;
}

.trash-button:hover,
.back-to-leaders-button:hover {
  background: rgba(255,255,255,0.12);
}

.trash-count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 21px;
  height: 21px;
  margin-right: 5px;
  padding: 0 5px;
  border-radius: 20px;
  background: #fff;
  color: #145c45;
  font-size: 11px;
  font-weight: 700;
}

.leader-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
}

.delete-leader-button {
  width: 34px;
  height: 34px;
  border: 1px solid #e7d2d2;
  border-radius: 8px;
  background: #fff7f7;
  color: #b42318;
  cursor: pointer;
  font-size: 15px;
  transition: 0.2s ease;
}

.delete-leader-button:hover {
  background: #feecec;
  transform: scale(1.04);
}

@media (max-width: 850px) {

  .topbar-actions {
    gap: 6px;
  }

  .trash-button,
  .back-to-leaders-button,
  .logout-button {
    padding: 8px 10px;
    font-size: 12px;
  }

}

@media (max-width: 600px) {

  .topbar-actions {
    gap: 5px;
  }

  .trash-button,
  .back-to-leaders-button,
  .logout-button {
    padding: 7px 8px;
    font-size: 11px;
  }

  .trash-count {
    min-width: 18px;
    height: 18px;
    font-size: 10px;
  }

}

