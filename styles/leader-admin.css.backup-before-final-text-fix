/* =========================================================
   GLOBAL
   ========================================================= */

* {
    box-sizing: border-box;
}

html,
body {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
}

body {
    margin: 0;
    min-width: 0;
    padding-top: 76px;
    font-family: Arial, "Tahoma", sans-serif;
    background: #f5f7f6;
    color: #1f2d28;
}

img,
video,
iframe,
svg {
    max-width: 100%;
}

button,
input,
select,
textarea {
    max-width: 100%;
}


/* =========================================================
   TOP BAR
   ========================================================= */

.topbar {
    width: 100%;
    height: 76px;
    padding: 0 32px;
    background: #145c45;
    color: white;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;

    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);

    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
}

.user-area {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
    flex: 1;
}

.topbar-right {
    display: flex;
    align-items: center;
    gap: 16px;
}

.topbar h1 {
    margin: 0;
    font-size: 24px;
}

.topbar p {
    margin: 5px 0 0;
    opacity: 0.85;
}

.menu-button {
    width: 42px;
    height: 42px;
    padding: 0;

    border: none;
    background: transparent;
    color: white;

    font-size: 28px;
    line-height: 1;

    cursor: pointer;
    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;
}

.menu-button:hover {
    background: rgba(255, 255, 255, 0.12);
    border-radius: 50%;
}

.back-button {
    width: 42px;
    height: 42px;

    border: 0;
    border-radius: 50%;

    background: rgba(255, 255, 255, 0.15);
    color: white;

    font-size: 25px;
    cursor: pointer;
}


/* =========================================================
   MAIN CONTAINER
   ========================================================= */

.container {
    width: min(1100px, calc(100% - 40px));
    margin: 35px auto;
}


/* =========================================================
   LEADER PROFILE
   ========================================================= */

.profile-card {
    background: white;
    border-radius: 20px;
    padding: 28px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.07);
}

.profile-top {
    display: flex;
    align-items: center;
    gap: 18px;

    padding-bottom: 25px;
    border-bottom: 1px solid #edf0ee;
}

.leader-avatar {
    width: 78px;
    height: 78px;

    border-radius: 50%;
    background: #e8f2ed;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 38px;
    flex-shrink: 0;
}

.leader-title {
    flex: 1;
    min-width: 0;
}

.leader-name-row {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
}

.leader-name-row h2 {
    margin: 0 0 8px;
}

.leader-title h2 {
    margin: 0 0 8px;
    font-size: 26px;
}

.leader-title p {
    margin: 0;
    color: #638074;
}

.leader-phone-top,
.phone-display {
    color: #638074;
    font-size: 15px;

    direction: ltr;
    unicode-bidi: isolate;
    text-align: left;
    white-space: nowrap;
}

.edit-button {
    border: 0;
    background: #145c45;
    color: white;

    padding: 11px 20px;
    border-radius: 10px;

    cursor: pointer;
    font-size: 15px;
}


/* =========================================================
   PROFILE INFO
   ========================================================= */

.info-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin-top: 25px;
}

.info-item {
    display: flex;
    align-items: center;
    gap: 12px;

    padding: 15px;
    background: #f8faf9;
    border-radius: 13px;

    min-width: 0;
}

.info-icon {
    width: 42px;
    height: 42px;

    border-radius: 10px;
    background: #e8f2ed;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 21px;
    flex-shrink: 0;
}

.info-item span {
    display: block;
    color: #71857d;
    font-size: 13px;
    margin-bottom: 5px;
}

.info-item strong {
    font-size: 15px;
}


/* =========================================================
   UNIFORM
   ========================================================= */

.uniform-check {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 27px;
    height: 27px;

    border-radius: 50%;

    font-weight: bold;
    font-size: 18px;
}

.has-uniform {
    background: #e4f6e9;
    color: #218739;
}

.no-uniform {
    background: #ffe6e6;
    color: #d62828;
}

#leaderUniform {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    white-space: nowrap;
}

#leaderUniform .uniform-clothes,
#leaderUniform .uniform-check,
#leaderUniform .uniform-text {
    display: inline-flex;
    align-items: center;
}


/* =========================================================
   CONTENT SECTIONS
   ========================================================= */

.boxes-grid {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 25px;
    min-width: 0;
}

.content-box {
    background: white;
    border-radius: 18px;
    padding: 16px;

    min-height: 0;

    box-shadow: 0 5px 18px rgba(0, 0, 0, 0.045);
    min-width: 0;
}

.box-header {
    display: flex;
    align-items: center;
    gap: 10px;

    padding-bottom: 12px;
    border-bottom: 1px solid #edf0ee;
}

.box-icon {
    width: 40px;
    height: 40px;

    border-radius: 11px;
    background: #e8f2ed;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 19px;
    flex-shrink: 0;
}

.box-header h3 {
    margin: 0 0 4px;
    font-size: 17px;
}

.box-header p {
    margin: 0;
    color: #7b8c85;
    font-size: 11px;
}

.empty-content {
    padding: 25px 8px;
    text-align: center;
    color: #87958f;
}

.state-box {
    background: white;
    border-radius: 18px;
    padding: 40px;

    text-align: center;

    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
}

.error-state {
    color: #b3261e;
}


/* =========================================================
   LEADER STATISTICS
   ========================================================= */

.leader-overview-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));

    gap: 10px;
    margin: 14px 0 16px;

    min-width: 0;
}

.leader-stat-card {
    min-width: 0;

    background: #fff;
    border: 1px solid #edf1ef;
    border-radius: 16px;

    padding: 12px 8px;

    text-align: center;

    box-shadow: 0 5px 18px rgba(0, 0, 0, 0.045);
}

.leader-stat-icon {
    width: 34px;
    height: 34px;

    margin: 0 auto 6px;

    border-radius: 10px;
    background: #e8f2ed;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 17px;
}

.leader-stat-number {
    font-size: 21px;
    line-height: 1.1;
    font-weight: 800;
    color: #145c45;
}

.leader-stat-label {
    margin-top: 4px;
    color: #718078;
    font-size: 12px;
    white-space: nowrap;
}


/* =========================================================
   ACTIVITY / MEMBER LIST
   ========================================================= */

.leader-admin-data-item {
    display: flex;
    align-items: center;
    gap: 8px;

    min-height: 52px;
    margin-top: 8px;
    padding: 10px 12px;

    border: 1px solid #edf1ef;
    border-radius: 13px;

    background: #fafcfb;
    color: #31423b;

    line-height: 1.35;
    text-align: right;

    min-width: 0;
}

.leader-admin-data-item strong {
    flex: 1;
    min-width: 0;

    font-size: 14px;
    font-weight: 700;
}

.leader-admin-data-item span {
    color: #718078;
    font-size: 12px;
    white-space: nowrap;
}

#activitiesList,
#membersList {
    padding-top: 3px;
}

#activitiesList .empty-content,
#membersList .empty-content {
    padding: 25px 8px;
}


/* =========================================================
   DELETE BUTTON
   ========================================================= */

.delete-leader-button {
    min-height: 44px;

    border-radius: 12px;
    background: #fff;
    color: #9b2c2c;

    border: 1px solid #ead3d3;

    font-size: 13px;
}


/* =========================================================
   MODAL
   ========================================================= */

.modal-overlay {
    position: fixed;
    inset: 0;

    background: rgba(0, 0, 0, 0.45);

    display: none;
    align-items: center;
    justify-content: center;

    padding: 20px;
    z-index: 1000;
}

.modal-overlay.show {
    display: flex;
}

.modal {
    width: min(560px, 100%);
    max-width: 100vw;
    max-height: 90vh;

    background: white;
    border-radius: 20px;
    padding: 25px;

    overflow-y: auto;
    overflow-x: hidden;
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;

    margin-bottom: 25px;
}

.modal-header h2 {
    margin: 0 0 6px;
}

.modal-header p {
    margin: 0;
    color: #718078;
}

.close-button {
    border: 0;
    background: transparent;

    font-size: 30px;
    cursor: pointer;
}


/* =========================================================
   FORM
   ========================================================= */

.form-group {
    margin-bottom: 18px;
}

.form-group label {
    display: block;
    margin-bottom: 8px;
    font-weight: 600;
}

.form-group input,
.form-group select {
    width: 100%;

    padding: 12px;

    border: 1px solid #d8e0dc;
    border-radius: 10px;

    font-size: 15px;
    background: white;
}


/* Phone */

.phone-input {
    display: flex;
    direction: ltr;
}

.phone-input span {
    background: #edf2ef;
    padding: 12px;

    border-radius: 10px 0 0 10px;
}

.phone-input input {
    border-radius: 0 10px 10px 0;

    direction: ltr;
    unicode-bidi: plaintext;
    text-align: left;
}


/* Birth date
   Three fields stay side-by-side on all screen sizes.
*/

.birth-date {
    display: grid;
    grid-template-columns: 1fr 1fr 1.3fr;
    gap: 8px;
}

.birth-date select {
    min-width: 0;
}


/* Uniform */

.uniform-options {
    display: flex;
    gap: 25px;
}

.uniform-options label {
    display: flex;
    align-items: center;
    gap: 7px;

    font-weight: normal;
}


/* Form buttons */

.form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;

    margin-top: 25px;
}

.cancel-button,
.save-button {
    border: 0;

    padding: 12px 22px;
    border-radius: 10px;

    cursor: pointer;
    font-size: 15px;
}

.cancel-button {
    background: #edf1ef;
}

.save-button {
    background: #145c45;
    color: white;
}

.save-button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 800px) {

    .info-grid {
        grid-template-columns: 1fr 1fr;
    }
}


/* =========================================================
   PHONE
   ========================================================= */

@media (max-width: 520px) {

    body {
        padding-top: 60px;
    }

    .topbar {
        height: 60px;
        padding: 0 14px;
    }

    .topbar .menu-button {
        width: 42px;
        height: 42px;
    }

    .container {
        width: calc(100% - 18px);
        margin: 12px auto 18px;
    }

    /* Statistics */

    .leader-overview-stats {
        gap: 7px;
        margin: 10px 0 12px;
    }

    .leader-stat-card {
        padding: 9px 5px;
        border-radius: 13px;
    }

    .leader-stat-icon {
        width: 30px;
        height: 30px;
        font-size: 15px;
        margin-bottom: 5px;
    }

    .leader-stat-number {
        font-size: 19px;
    }

    .leader-stat-label {
        font-size: 10px;
    }


    /* Profile */

    .profile-card {
        padding: 15px;
        border-radius: 17px;
    }

    .profile-top {
        gap: 12px;
        padding-bottom: 15px;
        flex-wrap: nowrap;
    }

    .leader-avatar {
        width: 58px;
        height: 58px;
        font-size: 29px;
    }

    .leader-title h2 {
        font-size: 20px;
        margin-bottom: 4px;
    }

    .leader-title p {
        font-size: 12px;
    }

    .edit-button {
        width: auto;
        padding: 9px 13px;
        font-size: 12px;
        white-space: nowrap;
    }


    /* Profile information */

    .profile-card .info-grid {
        grid-template-columns: 1fr 1fr;
        margin-top: 12px;
        gap: 8px;
    }

    .profile-card .info-item {
        padding: 10px;
        min-height: 48px;
    }

    .profile-card .info-icon {
        width: 34px;
        height: 34px;
        font-size: 17px;
    }

    .profile-card .info-item span {
        font-size: 11px;
        margin-bottom: 2px;
    }

    .profile-card .info-item strong {
        font-size: 13px;
    }


    /* Content */

    .content-box {
        padding: 13px;
        border-radius: 17px;
    }

    .leader-admin-data-item {
        padding: 9px 10px;
        min-height: 48px;
    }


    /* Modal */

    .modal {
        width: 100%;
        padding: 20px;
        border-radius: 18px;
    }

    /*
       IMPORTANT:
       Birth date intentionally stays 3 columns.
       Do not change this to 1fr.
    */

    .birth-date {
        grid-template-columns: 1fr 1fr 1.3fr;
        gap: 8px;
    }

    .form-group input,
    .form-group select {
        padding: 11px 9px;
        font-size: 14px;
    }
}


/* =========================================================
   CONTENT SAFETY / NO HORIZONTAL BREAK
   ========================================================= */

.profile-card,
.content-box,
.boxes-grid,
.leader-overview-stats,
.leader-admin-data-item,
.info-grid,
.info-item {
    min-width: 0;
    max-width: 100%;
}

.profile-card *,
.content-box *,
.leader-admin-data-item *,
.info-item * {
    min-width: 0;
    overflow-wrap: anywhere;
}

.boxes-grid,
.leader-overview-stats {
    overflow-x: hidden;
}
/* =======================================================
   MEMBERS SECTION — ADMIN
   ======================================================= */

.box-header-text {
    flex: 1;
}

.section-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-right: 6px;
    padding: 3px 9px;
    border-radius: 999px;
    background: #f1f3f5;
    color: #555;
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
}

.section-count.warning {
    background: #fff3e8;
    color: #b65b00;
}

.add-member-button {
    flex-shrink: 0;
    border: none;
    border-radius: 10px;
    padding: 9px 14px;
    background: #222;
    color: #fff;
    font-family: inherit;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.15s ease, opacity 0.15s ease;
}

.add-member-button:hover {
    opacity: 0.9;
}

.add-member-button:active {
    transform: scale(0.97);
}

@media (max-width: 600px) {
    .box-header {
        gap: 10px;
    }

    .add-member-button {
        padding: 8px 11px;
        font-size: 12px;
    }

    .section-count {
        padding: 2px 7px;
        font-size: 11px;
    }
}

/* =======================================================
   MEMBERS — ADMIN CARDS + ACTIONS
   ======================================================= */

.member-admin-item {
    display: flex;
    align-items: center;
    gap: 14px;
    cursor: pointer;
}

.member-admin-info {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 18px;
}

.member-admin-info strong {
    min-width: 130px;
}

.member-admin-info span {
    white-space: nowrap;
}

.member-uniform-ok {
    font-weight: 700;
}

.member-uniform-missing {
    font-weight: 700;
}

.member-admin-actions {
    display: flex;
    align-items: center;
    gap: 7px;
    flex-shrink: 0;
}

.member-edit-button,
.member-delete-button {
    border: none;
    border-radius: 8px;
    padding: 7px 11px;
    font-family: inherit;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
}

.member-edit-button {
    background: #f1f3f5;
    color: #333;
}

.member-delete-button {
    background: #fff0f0;
    color: #a33;
}

.member-edit-button:hover,
.member-delete-button:hover {
    opacity: 0.85;
}

@media (max-width: 700px) {

    .member-admin-item {
        align-items: flex-start;
        flex-wrap: wrap;
    }

    .member-admin-info {
        width: 100%;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px 14px;
    }

    .member-admin-info strong {
        min-width: 0;
        grid-column: 1 / -1;
    }

    .member-admin-actions {
        width: 100%;
        justify-content: flex-start;
    }
}

/* =========================================================
   CLEAN LEADER CARD — FINAL
   ========================================================= */

.profile-card {
    background: #fff;
    border-radius: 20px;
    padding: 24px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
    overflow: hidden;
}

.profile-top {
    display: flex;
    align-items: center;
    gap: 14px;
}

.leader-avatar {
    width: 68px;
    height: 68px;
    min-width: 68px;
    border-radius: 50%;
    background: #e8f2ed;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    font-size: 32px;
}

.leader-avatar img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
}

.leader-title {
    min-width: 0;
    flex: 1;
}

.leader-title h2 {
    margin: 0;
    font-size: 23px;
    line-height: 1.4;
    font-weight: 800;
}

.leader-title p {
    margin: 5px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: #777;
    font-weight: 500;
}

.leader-card-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-top: 17px;
}

.leader-card-actions .edit-button,
.leader-card-actions .delete-leader-button {
    width: 100%;
    height: 45px;
    min-height: 45px;
    margin: 0;
    padding: 0 14px;
    border-radius: 12px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    font: inherit;
    font-size: 15px;
    font-weight: 700;
    white-space: nowrap;
}

.leader-card-actions .edit-button {
    background: #145c45;
    color: #fff;
    border: 1px solid #145c45;
}

.leader-card-actions .delete-leader-button {
    background: #fff;
    color: #9b2c2c;
    border: 1px solid #ead1d1;
}

.leader-clean-info {
    margin-top: 19px;
    align-items: stretch;
    gap: 10px;
}

.leader-clean-info .info-item {
    min-width: 0;
    padding: 13px;
    min-height: 66px;
}

.leader-clean-info .info-item > div:last-child {
    min-width: 0;
}

.leader-clean-info .info-item span {
    font-size: 13px;
    margin-bottom: 4px;
    font-weight: 600;
    line-height: 1.4;
}

.leader-clean-info .info-item strong {
    font-size: 16px;
    line-height: 1.5;
    font-weight: 750;
    overflow-wrap: anywhere;
}

.leader-clean-info .info-icon {
    width: 40px;
    height: 40px;
    min-width: 40px;
    font-size: 20px;
}

#leaderPhone {
    direction: ltr;
    unicode-bidi: plaintext;
    white-space: nowrap;
    overflow-wrap: normal !important;
}

.leader-uniform-item {
    display: flex;
    align-items: center;
}

#leaderUniform {
    display: block;
}

.uniform-status {
    display: inline;
    font-size: 16px;
    font-weight: 750;
    line-height: 1.5;
    white-space: nowrap;
}

.uniform-status.has-uniform {
    color: #218739;
}

.uniform-status.no-uniform {
    color: #d62828;
}

.leader-overview-stats {
    display: none !important;
}

@media (max-width: 700px) {

    .profile-card {
        padding: 15px;
        border-radius: 17px;
    }

    .profile-top {
        gap: 10px;
        align-items: center;
    }

    .leader-avatar {
        width: 58px;
        height: 58px;
        min-width: 58px;
        font-size: 28px;
    }

    .leader-title h2 {
        font-size: 20px;
    }

    .leader-title p {
        font-size: 12px;
    }

    .leader-card-actions {
        gap: 8px;
        margin-top: 14px;
    }

    .leader-card-actions .edit-button,
    .leader-card-actions .delete-leader-button {
        height: 43px;
        min-height: 43px;
        padding: 0 10px;
        font-size: 13px;
    }

    .leader-clean-info {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
        margin-top: 14px;
    }

    .leader-clean-info .info-item {
        padding: 11px;
        min-height: 61px;
    }

    .leader-clean-info .info-item span {
        font-size: 12px;
    }

    .leader-clean-info .info-item strong {
        font-size: 14px;
        line-height: 1.5;
    }

    .leader-clean-info .info-icon {
        width: 38px;
        height: 38px;
        min-width: 38px;
        font-size: 19px;
    }

    .uniform-status {
        font-size: 14px;
        font-weight: 750;
